-- allium: 3
-- io.allium
-- Behaviour spec: channels, IO, file, encoding — open/puts/gets/read/
-- seek/eof/close/fconfigure/chan/file/glob/source, CLI exit semantics.
-- Oracle: tclsh 9.1.0 (core-9-1-0). A/B + T3/T4 rules re-anchored
-- 2026-11-27; remaining C-class coverage tracked in HANDOFF-SPEC-910.md §8.
-- rtcl divergences from this spec are tracked in DIVERGENCES.md
-- (D-29 … D-34；glob 归 D-26；台账为准).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── gets / read / eof ─────────────────────────────────────────────

rule GetsAtEofReturnsMinusOneAndEmptiesVar {
    -- gets at EOF returns -1 and (with varName) sets the variable to
    -- ""; eof is 1 only after the read that hit EOF. The successful read
    -- must be captured before the EOF read overwrites the variable.
    when: Evaluates("set f [open /tmp/rtcl_spec_gets.txt w]; puts $f hello; close $f; set f [open /tmp/rtcl_spec_gets.txt r]; set n [gets $f v]; set got $v; set e1 [eof $f]; set n2 [gets $f v]; set e2 [eof $f]; close $f; list $n $got $e1 $n2 $e2 [info exists v]")
    ensures: completion.code = ok
    ensures: completion.value = "5 hello 0 -1 1 1"
}

rule ReadCountIsCharactersNotBytes {
    -- read chan N reads N characters through the channel encoding, not
    -- N bytes.
    when: Evaluates("set f [open /tmp/rtcl_spec_read.txt w]; fconfigure $f -encoding utf-8; puts -nonewline $f \"héllo\"; close $f; set f [open /tmp/rtcl_spec_read.txt r]; set n [string length [read $f 3]]; close $f; set n")
    ensures: completion.code = ok
    ensures: completion.value = "3"
    -- rtcl: 2 (reads 3 bytes = "hé")  [D-31]
}

rule ReadZeroDoesNotSetEof {
    when: Evaluates("set f [open /tmp/rtcl_spec_read.txt r]; read $f 0; set e [eof $f]; close $f; set e")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- rtcl: 1 (read 0 marks at_eof)  [D-31]
}

rule ReadWriteFileInterleavesAtOnePosition {
    -- An r+ channel has ONE shared position: after reading 2 chars the
    -- next write overwrites in place ("AAB"), not appends.
    when: Evaluates("set f [open /tmp/rtcl_spec_rw.txt w+]; puts -nonewline $f AAA; seek $f 0; read $f 2; puts -nonewline $f B; close $f; set f [open /tmp/rtcl_spec_rw.txt r]; set s [read $f]; close $f; set s")
    ensures: completion.code = ok
    ensures: completion.value = "AAB"
    -- rtcl: "AAAA\nB" — BufReader prefetch desyncs the write offset
    -- (data-corruption class)  [D-29]
}

rule SeekOnNonseekableChannelMessage {
    when: Evaluates("catch {seek stdin 0} m; set m")
    ensures: completion.code = ok
    -- oracle: error during seek on "stdin": invalid seek
    -- rtcl: ... : stdin is not seekable  [D-35]
}

-- ── open / access ─────────────────────────────────────────────────

rule OpenMissingFileMessage {
    when: Evaluates("catch {open /tmp/rt_absent_zz r} m; set m")
    ensures: completion.code = ok
    -- oracle: couldn't open "/tmp/rt_absent_zz": no such file or directory
    -- rtcl: ...: No such file or directory (os error 2)
    -- (Rust io::Error Display leaks; tclsh is lowercase, no os-error tail)  [D-35]
}

rule OpenAcceptsPosixFlagList {
    -- The access argument may be a POSIX flag list like {RDONLY}.
    when: Evaluates("catch {open /tmp/rt_absent_zz {RDONLY}} m; set m")
    ensures: completion.code = ok
    -- oracle: couldn't open "/tmp/rt_absent_zz": no such file or directory
    --   (access parsed OK, file simply missing)
    -- rtcl: bad access mode "RDONLY"  [D-35]
}

-- ── puts ──────────────────────────────────────────────────────────

rule PutsRejectsFlagAfterChannel {
    -- puts -nonewline stderr msg (flag after the channel) is a
    -- wrong-#-args error.
    when: Evaluates("puts stderr -nonewline hi")
    ensures: completion.code = error
    -- oracle: wrong # args: should be "puts ?-nonewline? ?channelId? string"
    -- rtcl: prints "hi\n" (4-arg form silently accepted)  [D-35]
}

-- ── fconfigure / encoding ─────────────────────────────────────────

rule FconfigureEncodingMustBeKnown {
    when: Evaluates("catch {fconfigure stdout -encoding bogus} m; set m")
    ensures: completion.code = ok
    -- oracle: unknown encoding "bogus"
    -- rtcl: FIXED 2026-11-05（校验 + TCL LOOKUP ENCODING）[D-29]
}

rule EncodingCommandExists {
    -- The encoding command exists with convertfrom/convertto/dirs/names/
    -- profiles/system/user. 9.1's names table has 95 entries: the 8.6 set
    -- (86) plus utf-16/-le/-be, utf-32/-le/-be, ucs-2/-le/-be, cesu-8,
    -- minus identity. Profiles default to strict (see the rules below).
    when: Evaluates("llength [encoding names]")
    ensures: completion.code = ok
    ensures: completion.value = "95"
    -- probe 2026-11-27 tclsh9.1: llength [encoding names] => 95
    -- rtcl: command implemented (D-29 FIXED 2026-11-05), but the .enc
    --   table is the 86-name 8.6 set (identity kept; no utf-16/utf-32/
    --   ucs-2/cesu-8) — 9.1 name-table coverage is T3 migration work.
}

rule EncodingProfilesAreReplaceStrictTcl8 {
    -- encoding profiles lists the three TIP 656 profiles; strict is the
    -- default when -profile is omitted.
    when: Evaluates("encoding profiles")
    ensures: completion.code = ok
    ensures: completion.value = "replace strict tcl8"
    -- probe 2026-11-27 tclsh9.1
    -- rtcl: subcommand absent (convertfrom/convertto only take name data).
}

rule EncodingStrictProfileRejectsUnmappable {
    -- With the default strict profile, a character the target encoding
    -- cannot represent raises and names the source character index.
    when: Evaluates("catch {encoding convertto ascii \"hé\"} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "unexpected character at index 1: 'U+0000E9'"
    -- probe 2026-11-27 tclsh9.1
    -- rtcl: replaces with '?' (8.6-style) and never raises.
}

rule EncodingFailIndexReturnsPrefixAndIndex {
    -- -failindex turns a conversion error into a partial result: the prefix
    -- converted before the offending source byte/character, plus the index
    -- in var. A clean conversion stores -1.
    when: Evaluates("list [encoding convertto -failindex i ascii \"hé\"] $i")
    ensures: completion.code = ok
    ensures: completion.value = "h 1"
    -- probe 2026-11-27 tclsh9.1; successful form stores -1:
    --   set i X; encoding convertto -failindex i ascii "hi"; set i => -1
    -- decode direction: encoding convertfrom -failindex i utf-8
    --   [binary format H* ff] => "" and i = 0
    -- rtcl: -profile/-failindex not parsed (wrong # args).
}

rule EncodingTcl8ProfileReplaces {
    -- -profile tcl8 restores 8.6 behaviour: unrepresentable characters
    -- become '?' and no error/failindex is signalled (-1).
    when: Evaluates("encoding convertto -profile tcl8 ascii \"é\"")
    ensures: completion.code = ok
    ensures: completion.value = "?"
    -- probe 2026-11-27 tclsh9.1; with -failindex i, i = -1
    -- rtcl: replaces with '?' by default (matches tcl8, not strict).
}

rule EncodingUserMatchesSystem {
    -- encoding user returns the user-preference encoding; on non-Windows
    -- platforms it is the same as encoding system (utf-8 here).
    when: Evaluates("list [encoding user] [encoding system]")
    ensures: completion.code = ok
    ensures: completion.value = "utf-8 utf-8"
    -- probe 2026-11-27 tclsh9.1 on Linux
    -- rtcl: user subcommand absent.
}

-- ── 9.1 channels/encoding (T3, 2026-11-27) ──────────────────────
-- Probes: chan_copy_modes, chan_eofchar, chan_io_p3/p4/p7-p9/p11/p16/
-- p22, chan_names_order, chan_seek_tell. Re-run on tclsh 9.1.0.

rule EncodingBinaryNameRemoved {
    -- Tcl 9 removed the "binary" encoding; the error points at the two
    -- supported replacements.
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; set c [catch {fconfigure $f -encoding binary} m]; close $f; list $c [string match {unknown encoding \"binary\": No longer supported*} $m]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: chan_copy_modes/chan_eofchar (binary pairs), doc/encoding.n
}

rule FconfigureProfileDefaultsStrict {
    -- -profile defaults to strict; bad values name the three profiles.
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; list [fconfigure $f -profile] [catch {fconfigure $f -profile bogus} m] $m")
    ensures: completion.code = ok
    ensures: completion.value = "strict 1 {bad profile name \"bogus\": must be replace, strict, or tcl8}"
    -- errorCode: TCL ENCODING PROFILE bogus ; probe: chan_io_p9
}

rule FconfigureStatReportsMetadata {
    -- -stat returns the file metadata dict (dev/ino/type at least).
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; set s [fconfigure $f -stat]; close $f; list [dict exists $s dev] [dict exists $s ino] [dict exists $s type] [dict get $s type]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1 file"
    -- probe: chan_io_p9 among the fconfigure option table
}

rule FconfigureEofcharOutputFaceRemoved {
    -- An input eofchar is still settable (returns ""); the two-element
    -- [in out] form is rejected because the output face was removed.
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; set r [list [fconfigure $f -eofchar [format %c 26]] [catch {fconfigure $f -eofchar [list {} [format %c 3]]} m] $m]; close $f; set r")
    ensures: completion.code = ok
    ensures: completion.value = "{} 1 {bad value for -eofchar: must be non-NUL ASCII character}"
    -- probe: chan_io_p7/p16/p22
}

rule ChanIsBinaryTracksTranslation {
    -- chan isbinary is 1 only when the channel's translation is binary.
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; set a [chan isbinary $f]; fconfigure $f -translation binary; set b [chan isbinary $f]; close $f; list $a $b")
    ensures: completion.code = ok
    ensures: completion.value = "0 1"
    -- probe: chan_io_p3 (isbinary is in the subcommand table)
}

rule ChanNamesFiltersStdChannels {
    -- chan names patterns select channels; *out* is stdout, a non-match is
    -- empty. The full order is hash-table order, so it is not pinned here.
    when: Evaluates("list [chan names *out*] [chan names nope*]")
    ensures: completion.code = ok
    ensures: completion.value = "stdout {}"
    -- probe: chan_names_order/chan_io_p8 (fileN interleave by bucket)
}

rule ChanNamesCountsOpenFiles {
    -- Each open file adds exactly one fileN channel; close removes it.
    when: Evaluates("set a [llength [chan names file*]]; set f [open /tmp/rtcl_spec910_w w]; set b [llength [chan names file*]]; close $f; set c [llength [chan names file*]]; list [expr {$b-$a}] [expr {$c-$a}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0"
    -- probe: chan_names_order
}

rule FconfigureErrorsUseTclValueNumber {
    -- Bad option values share the unified TCL VALUE NUMBER errorCode (the
    -- pre-9.1 POSIX/other tails are gone).
    when: Evaluates("set f [open /tmp/rtcl_spec910_w w]; catch {fconfigure $f -buffersize bogus} m; close $f; list $m $::errorCode")
    ensures: completion.code = ok
    ensures: completion.value = "{expected integer but got \"bogus\"} {TCL VALUE NUMBER}"
    -- probe: chan_io_p11/p16/p22, incr_window_p*
}

rule ChannelReadStrictProfileRejectsBadBytes {
    -- Default strict profile: reading invalid UTF-8 raises an EILSEQ-class
    -- error rather than substituting.
    when: Evaluates("set h [open /tmp/rtcl_spec910_bad.bin w]; fconfigure $h -translation binary; puts -nonewline $h [binary format H* 61ff62]; close $h; set h [open /tmp/rtcl_spec910_bad.bin r]; set c [catch {read $h} m]; close $h; list $c [string match {*invalid or incomplete multibyte*} $m]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: chan_io_p9 (profile strict is the default)
}

rule SourceDefaultsToStrictUtf8 {
    -- source reads as strict UTF-8; bad bytes are a read error, not a
    -- silently evaluated script.
    when: Evaluates("set h [open /tmp/rtcl_spec910_src.bin w]; fconfigure $h -translation binary; puts -nonewline $h [binary format H* 736574207820310aff]; close $h; set c [catch {source /tmp/rtcl_spec910_src.bin} m]; list $c [string match {couldn't read file*} $m]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: doc/source.n (default system encoding, strict UTF-8 here)
}

rule ExecEncodingDecodesChildOutput {
    -- 9.1 exec takes -encoding for the child's stdout/stderr decode.
    when: Evaluates("exec -encoding utf-8 echo hi")
    ensures: completion.code = ok
    ensures: completion.value = "hi"
    -- probe: 2026-11-27 tclsh9.1 on Linux
}

rule SocketNodelayAndKeepalive {
    -- TCP sockets expose -nodelay/-keepalive as boolean channel options,
    -- default 0 and settable to 1.
    when: Evaluates("proc accept {chan addr port} {close $chan}; set srv [socket -server accept 0]; set port [lindex [fconfigure $srv -sockname] 2]; set c [socket 127.0.0.1 $port]; set r [list [fconfigure $c -nodelay] [fconfigure $c -keepalive]]; fconfigure $c -nodelay 1; fconfigure $c -keepalive 1; lappend r [fconfigure $c -nodelay] [fconfigure $c -keepalive]; close $c; close $srv; set r")
    ensures: completion.code = ok
    ensures: completion.value = "0 0 1 1"
    -- probe: 2026-11-27 tclsh9.1 loopback (port 0 ephemeral)
}

-- ── file ──────────────────────────────────────────────────────────

rule FileMtimeSetterSets {
    -- file mtime name time sets the mtime and returns it.
    when: Evaluates("set f [file tempfile]; close [open $f w]; set t [file mtime $f 1000]; file delete $f; set t")
    ensures: completion.code = ok
    ensures: completion.value = "1000"
    -- rtcl: setter silently ignored (returns current time)  [D-34]
}

rule FileStatFieldSet {
    -- file stat fills atime blksize blocks ctime dev gid ino mode mtime
    -- nlink size type uid.
    when: Evaluates("lsort [array names a]")
    -- after: file stat F a
    ensures: completion.code = ok
    -- oracle: 13 keys incl. blksize blocks ctime
    -- rtcl: 10 keys — missing blksize blocks ctime  [D-34]
}

rule FileCopyExistsMessage {
    when: Evaluates("set a /tmp/rt_cp_src; set b /tmp/rt_cp_dst; close [open $a w]; close [open $b w]; catch {file copy $a $b} m; file delete $a $b; set m")
    ensures: completion.code = ok
    -- oracle: error copying "SRC" to "DST": file already exists
    -- rtcl: error copying "SRC": target exists  [D-34]
}

rule FileDirnameOfRoot {
    when: Evaluates("file dirname /")
    ensures: completion.code = ok
    ensures: completion.value = "/"
    -- rtcl: "."  [D-34]
}

-- ── glob ──────────────────────────────────────────────────────────

rule GlobStarDoesNotMatchLeadingDot {
    when: Evaluates("set d /tmp/rt_glob_dot; file delete -force $d; file mkdir $d; close [open [file join $d .hid] w]; set r [glob -nocomplain -directory $d *]; file delete -force $d; set r")
    ensures: completion.code = ok
    ensures: completion.value = ""
    -- rtcl: matches .hid (glob crate require_literal_leading_dot=false)  [D-27]
}

rule GlobStarStarIsNotRecursive {
    -- ** in tclsh is two *s: no directory recursion.
    when: Evaluates("set d /tmp/rt_gt; file delete -force $d; file mkdir $d/a/b; set r [glob -nocomplain $d/**]; file delete -force $d; set r")
    ensures: completion.code = ok
    ensures: completion.value = "/tmp/rt_gt/a"
    -- oracle: matches /tmp/rt_gt/a only
    -- rtcl: recurses into a and b  [D-27]
}

-- ── fileevent / vwait ─────────────────────────────────────────────

rule FileeventValidatesChannelDirection {
    when: Evaluates("catch {fileevent stdout readable {}} m; set m")
    ensures: completion.code = ok
    -- oracle: channel is not readable
    -- rtcl: invalid command name "stdout" (fileevent is a tailcall stub
    --   that treats the handle as a command)  [D-35]
}

rule VwaitBlocksUntilVariableSet {
    -- vwait waits indefinitely for the variable; an empty event queue
    -- blocks rather than erroring.
    when: Evaluates("after 0 {set v 1}; vwait v")
    ensures: completion.code = ok
    -- oracle: blocks forever
    -- rtcl: error can't wait for variable "zz": would wait forever  [D-33]
}

-- ── CLI exit semantics ────────────────────────────────────────────

rule CommandModeExitPropagatesCode {
    -- rtcl -c 'exit N' must exit with status N like tclsh.
    when: Evaluates("set f [file tempfile]; set h [open $f w]; puts $h {exit 7}; close $h; catch {exec [info nameofexecutable] $f} m o; set r [lindex [dict get $o -errorcode] 2]; file delete $f; set r")
    ensures: completion.code = ok
    ensures: completion.value = "7"
    -- oracle (tclsh): no output, process rc=7
    -- rtcl: "Error: exit with value: 7" on stderr, rc=1  [D-32 FIXED 2026-11-03]
}

-- ── 9.1 file path surface (T4, 2026-11-27) ───────────────────────

rule FileTildeexpandExpandsHome {
    -- file tildeexpand is the only command that expands ~; it maps ~ and
    -- ~/x through HOME.
    when: Evaluates("list [expr {[file home] eq $env(HOME)}] [expr {[file tildeexpand ~/x] eq \"$env(HOME)/x\"}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: file_attrs91 (file home / file tildeexpand)
}

rule FileNormalizeDoesNotExpandTilde {
    -- 9.0 made ~ an ordinary path component: normalize keeps it literal.
    when: Evaluates("expr {[file normalize ~] eq \"[pwd]/~\"}")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: file_attrs91
}

rule FileTempdirIsDirectory {
    -- file tempdir exists and names a directory (value is randomized).
    when: Evaluates("file isdirectory [file tempdir]")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: 2026-11-27 tclsh9.1
}
