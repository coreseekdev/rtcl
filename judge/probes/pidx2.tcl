# 空转（T11b 普查 2026-11-26）：两边死在行5解析：`t {…$foo([abc}de])}` 大括号提前闭合（missing close-brace），行6–7 未跑
proc t {e} {
    if {[catch {expr $e} m]} { puts "ERR <<$e>>\n   $m" } else { puts "OK  <<$e>>: $m" }
}
t {123456789012345678901234567890*$foo([abc")}
t {123456789012345678901234567890*$foo([abc}de])}
t {123456789012345678901234567890*$foo(abc"def)}
t {123456789012345678901234567890*$foo([abc)"}
