proc pl {n} {
    set s ""
    set l {}
    set m [dict create]
    for {set i 0} {$i < $n} {incr i} {
        append s $i
        lappend l $i
        dict set m k$i $i
    }
    return [list [string length $s] [llength $l] [dict size $m] [lindex $l end] [dict get $m k0]]
}
