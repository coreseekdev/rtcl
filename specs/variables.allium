-- allium: 3
-- variables.allium
-- Behaviour spec: variable scoping in Tcl — proc frames, global, upvar,
-- namespaces, arrays. Oracle: tclsh 9.1.0 (core-9-1-0).
-- A/B + T4/T5 rules re-anchored 2026-11-27; remaining C-class coverage
-- tracked in HANDOFF-SPEC-910.md §8.
--
-- 9.1 namespace rule: an unqualified variable name inside a namespace eval
-- body resolves only within the current namespace (plus variable links in
-- the same body frame). The 8.6 fallback to a same-named global variable was
-- removed; see the 2026-11-27 oracle probes on the NsBody* rules below.

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── proc argument binding ─────────────────────────────────────────

rule ProcMissingArgumentErrors {
    -- Calling a proc with fewer arguments than required (non-defaulted)
    -- parameters is a wrong-#-args error; the parameter is never
    -- silently bound to the empty string.
    when: Evaluates("proc f {a b} {return $b}; f 1")
    ensures: completion.code = error
    -- oracle message: wrong # args: should be "f a b"
}

rule ProcExtraArgumentErrors {
    -- Calling a proc with more arguments than parameters (and no args
    -- varargs parameter) is a wrong-#-args error.
    when: Evaluates("proc f {a} {return $a}; f 1 2")
    ensures: completion.code = error
    -- oracle message: wrong # args: should be "f a"
}

rule ProcDefaultParameterFillsMissing {
    when: Evaluates("proc f {a {b 9}} {return $b}; f 1")
    ensures: completion.code = ok
    ensures: completion.value = "9"
}

rule ProcArgsCollectsRemainderAsList {
    -- A trailing parameter named `args` collects all remaining actual
    -- arguments as a proper list (round-trippable via llength/lindex).
    when: Evaluates("proc f args {return [llength $args]}; f \"a b\" c")
    ensures: completion.code = ok
    ensures: completion.value = "2"
    -- probe: proc f args {return $args}; puts [f "a}b" c] => a\}b c
}

-- ── scoping ───────────────────────────────────────────────────────

rule ProcVariablesAreLocal {
    -- set inside a proc creates a local; it is invisible outside.
    when: Evaluates("proc f {} {set x 5}; f; info exists x")
    ensures: completion.code = ok
    ensures: completion.value = "0"
}

rule GlobalLinksLocalToGlobal {
    when: Evaluates("set x 1; proc f {} {global x; set x 2}; f; set x")
    ensures: completion.code = ok
    ensures: completion.value = "2"
}

rule UpvarLinksToCallerFrame {
    -- upvar 1 links a local name to a variable in the caller's frame.
    when: Evaluates("set g 0; proc f {} {upvar 1 g l; set l 42}; f; set g")
    ensures: completion.code = ok
    ensures: completion.value = "42"
}

rule UplevelBeyondStackIsError {
    -- uplevel with a level above the current call stack is an error,
    -- never a silent evaluation in the current scope.
    when: Evaluates("uplevel 1 {set q 9}")
    ensures: completion.code = error
    -- oracle message: bad level "1"
}

rule ArrayElementsAreVariables {
    when: Evaluates("set a(1) x; set a(1)")
    ensures: completion.code = ok
    ensures: completion.value = "x"
}

-- ── arrays ────────────────────────────────────────────────────────

rule ArrayNamesListsKeys {
    -- array names lists element names (pattern-filtered when given);
    -- a wholly missing array yields the empty list.
    when: Evaluates("array set a {b 2 a 1}; array names a")
    ensures: completion.code = ok
    -- oracle value: "a b" (tclsh 9.1.0 order for this shape; large
    -- tables are hash order — consumers must not rely on ordering)
}

rule ArrayExistsAndSize {
    when: Evaluates("array set a {x 1 y 2}; list [array exists a] [array exists nope] [array size a]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0 2"
    -- also: array set a {}; array size a => 0 (empty array EXISTS as array)
}

rule UnsetElementShrinksArray {
    -- Unsetting the last element of an array leaves the array variable
    -- itself existing (with zero elements).
    when: Evaluates("array set a {x 1 y 2}; unset a(x); list [array size a] [info exists a]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
}

rule ArrayUnsetWholeRemovesVariable {
    -- `array unset a` without a pattern removes the array variable
    -- itself: info exists a => 0 afterwards.
    when: Evaluates("array set a {x 1}; array unset a; info exists a")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- rtcl: leaves the variable (info exists => 1)  [D-35]
    -- element (array unset a x) and pattern (array unset a y*) forms
    -- match tclsh; array unset on an absent name is a silent no-op.
}

-- ── namespaces ────────────────────────────────────────────────────

rule NamespaceEvalQualifiesVariables {
    -- set inside `namespace eval foo` writes ::foo::x, not ::x.
    when: Evaluates("namespace eval foo {set x 1}; set ::foo::x")
    ensures: completion.code = ok
    ensures: completion.value = "1"
}

rule ProcExecutesInDefinitionNamespace {
    -- A proc defined inside `namespace eval foo` observes
    -- [namespace current] = ::foo when called, regardless of caller.
    when: Evaluates("namespace eval foo {proc p {} {namespace current}}; foo::p")
    ensures: completion.code = ok
    ensures: completion.value = "::foo"
}

rule NamespaceVariableCommandLinksNamespaceVar {
    when: Evaluates("namespace eval foo {variable v 7}; set ::foo::v")
    ensures: completion.code = ok
    ensures: completion.value = "7"
}

-- ── namespaces deep water: ns × proc × upvar × delete ────────────
-- 2026-11-03 深水区检测（C2'/链修复后的语义面）。每条 rule 附完整
-- probe 行（specs/variables-deep.probes 同源，probe.sh 差分）。

rule ProcSetCreatesFrameLocalNotNsVar {
    -- proc 体是严格局部帧：ns 内定义的 proc 调用时 set 建**帧局部**，
    -- 定义 ns 的变量表不出现该名（proc 的 ns 只影响命令解析与
    -- variable 链目标）。
    when: Evaluates("namespace eval d {proc p {} {set x 1}}; d::p; info exists d::x")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- probe: namespace eval d { proc p {} {set x 1} }; d::p; puts [info exists d::x]
}

rule ProcVariableDeclAccumulatesAcrossCalls {
    -- proc 内 variable 声明链到**定义 ns** 的变量表；不带初值的声明保留
    -- 现值（带初值的 variable 每次都会赋值，见 oracle 9.1）——跨调用累积。
    when: Evaluates("namespace eval d {variable x 5; proc p {} {variable x; incr x}}; d::p; d::p; set ::d::x")
    ensures: completion.code = ok
    ensures: completion.value = "7"
    -- probe: namespace eval d { variable x 5; proc p {} {variable x; incr x} }; d::p; d::p; puts [set ::d::x]
}

rule ProcCalledFromNsBodyStillStrictLocal {
    -- 调用点在 ns eval 体内也不改变 proc 的严格局部性。
    when: Evaluates("proc p {} {set z 9}; namespace eval d {p}; info exists d::z")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- probe: proc p {} {set z 9}; namespace eval d {p}; puts [info exists d::z]
}

rule ProcGlobalTargetsRootNamespace {
    -- global 恒链**根 ns**，与 proc 的定义 ns 无关。
    when: Evaluates("namespace eval d {proc p {} {global g; set g 42}}; d::p; set g")
    ensures: completion.code = ok
    ensures: completion.value = "42"
    -- probe: namespace eval d { proc p {} {global g; set g 42} }; d::p; puts $g
}

rule UpvarThroughNsEvalFrame {
    -- ns eval 体是帧：upvar 1 从体链到**调用 namespace eval 的帧**
    -- （顶层的 g 是全局 g）。
    when: Evaluates("set g 0; namespace eval d {upvar 1 g l; set l 5}; set g")
    ensures: completion.code = ok
    ensures: completion.value = "5"
    -- probe: set g 0; namespace eval d {upvar 1 g l; set l 5}; puts $g
}

rule UpvarElementQualifiedTarget {
    -- upvar 0 链元素目标（限定名绕过 proc 帧局部解析）。
    when: Evaluates("set a(e) 1; proc p {} {upvar 0 ::a(e) x; set x 7}; p; set a(e)")
    ensures: completion.code = ok
    ensures: completion.value = "7"
    -- probe: set a(e) 1; proc p {} {upvar 0 ::a(e) x; set x 7}; p; puts $a(e)
}

rule UpvarToDeletedNsVariable {
    -- ns delete 后对已销毁 ns 变量建 upvar 链：建链时刻目标的父 ns
    -- 必须存在，否则报 can't access（var-1.15 族深水）。oracle 实证
    -- 2026-11-03；rtcl 原静默建帧局部（Frame 臂字面名）已修。
    when: Evaluates("namespace eval d {variable v 5}; proc mk {} {upvar 0 ::d::v l; set l 9}; namespace delete d; catch {mk} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "can't access \"::d::v\": parent namespace doesn't exist"
    -- probe: namespace eval d {variable v 5}; proc mk {} {upvar 0 ::d::v l; set l 9}; namespace delete d; catch {mk} m; puts $m
}

rule VariableLinkIsPerEvalBodyFrame {
    -- variable 声明是**体帧瞬态**：内层 ns eval 体无链接；其裸名 set
    -- 落内层命名空间自身（::o::i::s），既不回退全局，也不写外层链接
    -- （::o::s 保持 9，全局 s 保持 1）。
    when: Evaluates("set s 1; namespace eval o {variable s 9; namespace eval i {set s 2}}; list $::o::s $s [set ::o::i::s]")
    ensures: completion.code = ok
    ensures: completion.value = "9 1 2"
    -- probe 2026-11-27 tclsh9.1: ...; puts [list $::o::s $s [set ::o::i::s]] => 9 1 2
    -- 8.6 spec pinned "9 2" (inner body set fell back to the global); removed in 9.x.
}

rule NsBodySetHitsDeclaredLink {
    -- 同帧内声明后的裸名 set 落链接目标（ns 变量），全局不动。
    when: Evaluates("set s 1; namespace eval o {variable s 9; set s 8}; list $::o::s $s")
    ensures: completion.code = ok
    ensures: completion.value = "8 1"
    -- probe: set s 1; namespace eval o {variable s 9; set s 8}; puts [list $::o::s $s]
}

rule NsDeleteDestroysVariables {
    when: Evaluates("namespace eval d {set x 5}; namespace delete d; info exists d::x")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- probe: namespace eval d {set x 5}; namespace delete d; puts [info exists d::x]
}

rule SelfDeleteBodyKeepsRunning {
    -- 体中自删：body 继续跑、[namespace current] 保持到体退出
    --（tclsh 34.x）；之后的 set 落已删 ns 的**帧视图**（随体消亡，
    -- ns 变量表不复活——限定查询恒不可见，裸名 keep-alive 链接除外
    --）。oracle 实证 2026-11-03：info exists d::y = 0。rtcl 修复 =
    -- 限定名死父 ns 守卫 + ns_eval 退出清扫（D-2 FIXED）。
    when: Evaluates("namespace eval d {namespace delete [namespace current]; set y 3}; info exists d::y")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- probe: namespace eval d {namespace delete [namespace current]; set y 3}; puts [info exists d::y]
}

rule WhichVariableDoesNotFallBackToGlobal {
    -- 9.1: namespace which -variable reports only a variable visible in the
    -- current namespace (or a variable link in scope). A same-named global
    -- is NOT visible from a namespace body, so the answer is empty.
    when: Evaluates("set g 1; namespace eval d {namespace which -variable g}")
    ensures: completion.code = ok
    ensures: completion.value = ""
    -- probe 2026-11-27 tclsh9.1: set g 1; puts [namespace eval d {namespace which -variable g}]
    --   => (empty); namespace eval d {set g} => can't read "g": no such variable
    -- contrast: namespace eval d {variable w 5}; namespace which -variable w => ::d::w
    -- 8.6 spec pinned "::g" (global fallback); removed in 9.x.
}

rule NsBodyIncrCreatesNamespaceVariable {
    -- 9.1: an unqualified incr in a namespace eval body resolves in the
    -- current namespace, creating ::d::w (0 -> 1); the global w is left
    -- untouched. The preceding set d2 also lands in ::d::d2.
    when: Evaluates("set w 1; namespace eval d {set d2 [incr w]}; list $w $::d::w $::d::d2")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1"
    -- probe 2026-11-27 tclsh9.1: set w 1; namespace eval d {set d2 [incr w]}; puts [list $w $::d::w $::d::d2]
    -- reading bare $d2 afterwards errors: can't read "d2": no such variable
    -- 8.6 spec pinned "3 3" (ns body incr saw the global slot); removed in 9.x.
}

rule NsBodyIncrDoesNotTouchGlobal {
    -- A global linked write (proc global) and a later namespace-body incr
    -- are separate variables: the body incr creates ::d::k while the global
    -- keeps the value written through the link.
    when: Evaluates("set k 1; proc bump {} {global k; incr k}; bump; namespace eval d {incr k}; list $k $::d::k")
    ensures: completion.code = ok
    ensures: completion.value = "2 1"
    -- probe 2026-11-27 tclsh9.1: ...; puts [list $k $::d::k] => 2 1
    -- 8.6 spec pinned "3" (body incr added to the global); removed in 9.x.
}

rule NsBodyArrayElementStaysInNamespace {
    -- An element write in a namespace eval body creates the element in the
    -- namespace's own array (::d::a(y)); it does not create the element in a
    -- same-named global array.
    when: Evaluates("set a(x) 1; namespace eval d {set a(y) 2}; list [array names ::a] [array names ::d::a]")
    ensures: completion.code = ok
    ensures: completion.value = "x y"
    -- probe 2026-11-27 tclsh9.1: ...; puts [list [array names a] [array names ::d::a]]
    -- reading $a(y) afterwards errors: no such element in array
    -- 8.6 spec pinned "1 2" (element write hit the global array base); removed in 9.x.
}

rule WhichVariableReportsNsVar {
    when: Evaluates("namespace eval d {variable v; namespace which -variable v}")
    ensures: completion.code = ok
    ensures: completion.value = "::d::v"
    -- probe: namespace eval d {variable v; puts [namespace which -variable v]}
}

-- ── 9.1 namespace/upvar deep water (T5, 2026-11-27) ─────────────

rule NamespaceInfoVarsExcludesGlobals {
    -- info vars inside a namespace lists only that namespace's variables;
    -- global names (argv, env, ...) are not visible.
    when: Evaluates("namespace eval nn {set zz 2; expr {[lsearch -exact [info vars] zz] >= 0 && [lsearch -exact [info vars] argv] < 0}}")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: q114b
}

rule UplevelFromNamespaceBodySeesNamespaceFrame {
    -- A proc called from a namespace eval body has that body as its caller
    -- frame: uplevel 1 {info vars} reports the namespace variables, not the
    -- proc's own locals.
    when: Evaluates("namespace eval s {variable x 0; variable y 1; proc show {} {uplevel 1 {info vars}}; show}")
    ensures: completion.code = ok
    ensures: completion.value = "x y"
    -- probe: u72/p-uplevel-ns
}

rule NamespaceVariableWithoutValueIsUnset {
    -- `variable x` declares without assigning: the declaration exists but
    -- reads as unset until a value is assigned.
    when: Evaluates("namespace eval t2 {variable x; list [info exists x] [catch {set x} m] $m}")
    ensures: completion.code = ok
    ensures: completion.value = "0 1 {can't read \"x\": no such variable}"
    -- probe: vm3
}

rule NamespaceVariableRecreatedAfterUnset {
    -- After unset, a plain set in the namespace recreates the variable at
    -- the same namespace-qualified location.
    when: Evaluates("namespace eval t2 {variable x 5; unset x}; namespace eval t2 {set x 7}; list [set ::t2::x] [namespace eval t2 {namespace which -variable x}]")
    ensures: completion.code = ok
    ensures: completion.value = "7 ::t2::x"
    -- probe: vm3
}

rule ErrorCodeNotPresetBeforeFirstError {
    -- ::errorCode and ::errorInfo do not exist until a real error occurs;
    -- a successful evaluation does not create them.
    when: Evaluates("list [info exists ::errorCode] [info exists ::errorInfo]")
    ensures: completion.code = ok
    ensures: completion.value = "0 0"
    -- probe: ec2 (fresh interp; after `error foo`, errorCode is NONE)
}

rule UpvarBadLevelMessage {
    -- An unusable uplevel level is `bad level "<text>"`; level parsing is
    -- not integer-literal based (#0, 0x, +2 are all rejected).
    when: Evaluates("catch {upvar 99 x y} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "bad level \"99\""
    -- probe: upvar_levels (u5/u6/u9/u14/u17)
}

rule UpvarRejectsSelfExistingAndTraced {
    -- upvar refuses a self-link, a name already local in the target frame,
    -- and a variable carrying traces.
    when: Evaluates("apply {{} {set a 1; catch {upvar 0 a a} m1; catch {upvar b a} m2; trace add variable c write cb; catch {upvar b c} m3; list $m1 $m2 $m3}}")
    ensures: completion.code = ok
    ensures: completion.value = "{can't upvar from variable to itself} {variable \"a\" already exists} {variable \"c\" has traces: can't use for upvar}"
    -- probe: upvar_levels (u20-u24)
}

rule IncrBadIncrementLeavesVariableUnchanged {
    -- A failed incr neither changes an existing value nor creates a missing
    -- variable.
    when: Evaluates("set x 1; catch {incr x 1a}; list $x [info exists nosuch]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0"
    -- probe: incr_frame
}

rule NamespaceParentMustExist {
    -- Writing through a qualified name whose parent namespace is missing
    -- fails; variable declarations use the "can't define" wording.
    when: Evaluates("list [catch {set ::nope::zz 1} m] $m [catch {namespace eval pns {variable sev:::en 7}} m2] $m2")
    ensures: completion.code = ok
    ensures: completion.value = "1 {can't set \"::nope::zz\": parent namespace doesn't exist} 1 {can't define \"sev:::en\": parent namespace doesn't exist}"
    -- probe: trv_p8
}

rule ExprArrayIndexParseErrors {
    -- An unbalanced quote inside an array index is a parse error naming the
    -- index, not an attempt to read a variable with a weird name.
    when: Evaluates("catch {expr {$foo(\"x)}} m; string match {invalid character in array index*} $m")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: pidx/pidx3
}

-- ── 9.1 array default / array for / const (T4, 2026-11-27) ──────

rule ArrayDefaultFillsMissingElementWithoutCreatingIt {
    -- Reading a missing element of a defaulted array returns the default,
    -- but does not create the element or grow the array.
    when: Evaluates("array set a {x 1}; array default set a foo; list $a(x) $a(y) [info exists a(y)] [array size a] [array default get a]")
    ensures: completion.code = ok
    ensures: completion.value = "1 foo 0 1 foo"
    -- probe: arrayconst91 (TIP 508)
}

rule ArrayForIteratesKeyValuePairs {
    -- array for binds {key value} in unspecified order; lsort makes it
    -- observable.
    when: Evaluates("array set f1 {b 2 a 1}; set out {}; array for {k v} f1 {lappend out $k=$v}; lsort $out")
    ensures: completion.code = ok
    ensures: completion.value = "a=1 b=2"
    -- probe: arrayconst91
}

rule ConstFreezesVariable {
    -- const assigns once and rejects later set/unset (including append/incr
    -- which are set forms); the value remains readable.
    when: Evaluates("const Z 5; list $Z [catch {set Z 9} m] $m [catch {unset Z} m2] $m2")
    ensures: completion.code = ok
    ensures: completion.value = "5 1 {can't set \"Z\": variable is a constant} 1 {can't unset \"Z\": variable is a constant}"
    -- probe: arrayconst91 (Tcl_ConstObjCmd/VAR_CONSTANT)
}

rule InfoConstantsListsDeclared {
    -- info consts lists constants; info constant returns the frozen value.
    when: Evaluates("const CX 1; list [expr {[lsearch -exact [info consts] CX] >= 0}] [info constant CX]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: arrayconst91
}
