-- allium: 3
-- string.allium
-- Behaviour spec: Tcl string commands. Oracle: tclsh 9.1.0 (core-9-1-0).
-- T1/T2/T3 rules re-anchored 2026-11-27.
--
-- Indices in Tcl strings are character (code point) based, never byte
-- offsets.  tclsh 9.1 counts astral-plane characters as one code point
-- (`string length "a\U00010000c"` = 3); an explicit surrogate pair is
-- two characters (= 4).  This supersedes the 8.6 UCS-2 note (D-27).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

rule StringIndicesAreCharacterBased {
    -- string index / range / first / last count characters, not bytes.
    when: Evaluates("string first y héy")
    ensures: completion.code = ok
    ensures: completion.value = "2"
    -- also: string index héllo 1 => é ; string length héllo => 5
}

rule StringFirstLastReturnMinusOneWhenAbsent {
    when: Evaluates("string first z hello")
    ensures: completion.code = ok
    ensures: completion.value = "-1"
    -- argument order: string first needleString haystackString ?startIndex?
}

rule StringTotitleOnlyFirstCharacter {
    -- totitle capitalises the first character of the whole string and
    -- lowercases the rest; it is not per-word capitalisation.
    when: Evaluates("string totitle \"hello world\"")
    ensures: completion.code = ok
    ensures: completion.value = "Hello world"
}

rule StringRepeatNegativeCountIsEmpty {
    -- A negative repeat count yields the empty string, not an error.
    when: Evaluates("string repeat ab -1")
    ensures: completion.code = ok
    ensures: completion.value = ""
}

rule StringIsBooleanAcceptsAbbreviations {
    -- Boolean strings accept any unique prefix: tru, fals, y, n, of...
    when: Evaluates("string is boolean tru")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- 9.1 booleans are 0/1 and true/false words only: `string is
    -- boolean 2` => 0, `0x10` => 0 (8.6 accepted any nonzero number).
}

rule StringIsIntegerAcceptsWhitespaceAndHex {
    when: Evaluates("string is integer \" 42\"")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- also: string is integer 0x10 => 1
}

rule StringIsListRejectsMalformed {
    when: Evaluates("string is list [format %c 123]")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- probe 2026-11-28 tclsh9.1
}

rule StringTrimRemovesCharSetFromBothEnds {
    when: Evaluates("string trim \"xxhixx\" x")
    ensures: completion.code = ok
    ensures: completion.value = "hi"
    -- default trim set is whitespace
}

rule StringMatchIsGlob {
    when: Evaluates("string match a*c abc")
    ensures: completion.code = ok
    ensures: completion.value = "1"
}

rule StringMapUsesEarliestLongestLeftmost {
    -- map scans left to right; at each position the first mapping pair
    -- whose key matches is applied; keys are never matched inside output.
    when: Evaluates("string map {a b} aaa")
    ensures: completion.code = ok
    ensures: completion.value = "bbb"
}

rule StringEqualAndCompare {
    when: Evaluates("string equal -length 2 abc abd")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- compare returns -1/0/1; both support -nocase and -length
}

-- ── 9.1 integer literal grammar (T1, 2026-11-27) ────────────────

rule StringIsIntegerUses9LiteralGrammar {
    -- string is integer accepts 0o/0b/0x, leading-zero decimal and
    -- underscore separators; malformed radix prefixes are rejected.
    when: Evaluates("list [string is integer 0o17] [string is integer 0b101] [string is integer 010] [string is integer 08] [string is integer 0b2] [string is integer 0x]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1 1 0 0"
    -- probe: s_probe (0b2/0x are false; bignum still integer)
}

rule StringIsWideIntegerExcludesBignum {
    -- wideinteger means fits in 64 bits; a bignum is not wideinteger.
    when: Evaluates("list [string is wideinteger 9223372036854775807] [string is wideinteger 9223372036854775808] [string is wideinteger 0x10]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0 1"
    -- probe: s_probe
}

-- ── 9.1 Unicode classes / dict class (T3, 2026-11-27) ────────────

rule StringIsDictClass {
    -- 9.1 adds the dict class (a well-formed even-sized list).
    when: Evaluates("list [string is dict {a 1 b 2}] [string is dict {a}] [string is dict {}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0 1"
    -- probe: probe5/probe9
    -- rtcl: bad class "dict"（9.1 dict 类未实装，迁移面）
}

rule StringIsDigitCoversUnicode18 {
    -- Unicode 18.0 digit data: Adlam, Devanagari and mathematical digits
    -- are all digits.
    when: Evaluates("list [string is digit [format %c 0x1E950]] [string is digit ९] [string is digit 𝟘]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1"
    -- probe: probe5/probe6
}

rule StringIsAmbiguousClassNamesTheMenu {
    -- A one-letter class abbreviation that matches several classes is an
    -- ambiguity error carrying the full 9.1 class menu.
    when: Evaluates("catch {string is a x} m; string match {ambiguous class \"a\": must be alnum, alpha, ascii, control, boolean, dict, digit, double, entier, false, graph, integer, list, lower, print, punct, space, true, upper, wideinteger, wordchar, or xdigit} $m")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: probe9 (bad class "bogus" uses the same menu)
}

-- ── 9.1 index expressions and 64-bit range (T2, 2026-11-27) ─────
-- Probes: ix1-ix6, cmp_string_index; re-run on tclsh 9.1.0.

rule StringIndexAcceptsOneOffsetTerm {
    -- An index is an integer literal optionally followed by one signed
    -- integer offset (end-1, 0x1+1, 1++1); no whitespace inside.
    when: Evaluates("list [string index abcdefgh 1+1] [string index abcdefgh 0x1+1] [string index abcdefgh 1++1] [string index abcdefgh end-1]")
    ensures: completion.code = ok
    ensures: completion.value = "c c c g"
    -- probe: ix1/ix3/ix6
}

rule StringIndexRejectsChainedTerms {
    -- A second offset term is a bad index, not left-to-right arithmetic.
    when: Evaluates("catch {string index abcdefgh 1+1+1} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "bad index \"1+1+1\": must be integer?[+-]integer? or end?[+-]integer?"
    -- probe: ix1 (same text for 1+, x+1, 1.5, empty)
}

rule StringIndexIs64Bit {
    -- Index arithmetic is 64-bit: values beyond the 32-bit range are not
    -- wrapped; an out-of-range index is simply empty.
    when: Evaluates("list [string index abcdefgh 4294967296] [string index abcdefgh -4294967295] [string index abcdefgh 9223372036854775807] [string range ab 2147483647 2147483647]")
    ensures: completion.code = ok
    ensures: completion.value = "{} {} {} {}"
    -- probe: ix3/ix4/ix5
}
