# 异常深水探针（error-deep;probe.sh 差分;文件模式专属项见 error-toplevel.probes）
catch {error boom} m o ; puts "$m | $o"
catch {break} m o ; puts $o
puts [catch {return hi} v o] ; puts $o
puts [catch {return -code 7 x} m o]
puts [catch {return -code error boom} m o] ; puts $o
catch {exit 3} m ; puts after
proc p {} {return -errorcode {A B} v} ; catch p ; catch {expr 1/0} ; puts $errorCode
try {error y} on error {m o} {puts $::errorInfo}
catch {try {expr 1/0} trap {ARITH DIVZERO *} {m} {puts TRAP:$m}} m2; puts $m2
catch {throw {E C} msg} m ; puts "$m|$::errorCode"
proc p2 {} {break} ; catch p2 m ; puts "$m|$::errorInfo"
catch {try {error x} finally {error finErr}} m ; puts $m
set errorCode STALE ; set z 1 ; puts $errorCode
proc q2 {} {error m2 info2 C} ; catch q2 ; puts "$::errorInfo|$::errorCode"
catch {nosuchcmd a} m o ; puts "$m | [dict keys $o]"
proc d2 {} {error i2} ; proc d1 {} {catch {d2} ; error re} ; catch d1 ; puts $::errorInfo
catch {namespace eval ::n {error inside}} m; puts $m
proc f2 {} {return -level 2 -code error deep} ; proc f1 {} {f2} ; catch f1 m ; puts "$m|$::errorInfo"
puts [catch {return -level 2 v} m o] ; puts "$m|$o"
catch {try {error x} on error {} {} finally {}} m ; puts $m
# ── D-3 CALL/UP 条目形（2026-11-06 对齐：调用词重建 + 每次日志事件一帧）──
proc caf {a b} {error x} ; catch {caf {a b} {c d}} m o ; puts [dict get $o -errorstack]
proc cap {} {error x} ; catch {apply {{q} {error x}} {a b}} m o ; puts [dict get $o -errorstack]
proc cup {} {uplevel 1 {error x}} ; catch {cup} m o ; puts [dict get $o -errorstack]
proc ccat {} {set s "error x" ; catch $s m o ; puts [dict get $o -errorstack]} ; ccat
proc ccat2 {} {set s "error x" ; catch $s m o ; puts [dict get $o -errorinfo]} ; ccat2
catch {namespace eval nn {namespace eval mm {error x}}} m o ; puts [dict get $o -errorstack]
proc cif {} {set q {error x} ; if 1 $q} ; catch {cif} m o ; puts $::errorInfo
proc cwh {} {set q {error x} ; while 1 $q} ; catch {cwh} m o ; puts [dict get $o -errorstack]
proc cfo {} {set q {error x} ; for {} 1 {} $q} ; catch {cfo} m o ; puts [dict get $o -errorstack]
proc cfo2 {} {set q {error x} ; for {} 1 $q {}} ; catch {cfo2} m o ; puts [dict get $o -errorinfo]
proc ctry {} {set q {error x} ; try $q} ; catch {ctry} m o ; puts [dict get $o -errorstack]
proc ch1 {} {try {error x} on error {m o} {error h}} ; catch {ch1} m o ; puts [dict get $o -errorstack]
proc cno {} {namespace eval nn {error x}} ; catch {cno} m o ; puts [dict get $o -errorstack]
proc cta {} {tailcall caf2 9} ; proc caf2 {a b} {} ; catch {cta} m o ; puts [dict get $o -errorstack]
proc cw {} {set x 5 ; nosuch $x} ; catch {cw} m o ; puts [dict get $o -errorstack]
proc cw2 {} {nosuch [expr {1+1}]} ; catch {cw2} m o ; puts [dict get $o -errorstack]
