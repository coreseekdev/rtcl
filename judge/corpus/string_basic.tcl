# string commands
puts [string length "hello"]
puts [string range "hello world" 6 end]
puts [string toupper "hello"]
puts [string tolower "HELLO"]
puts [string trim "  hi  "]
puts [string trimleft "xxhixx" "x"]
puts [string index "hello" 1]
puts [string first "lo" "hello"]
puts [string last "l" "hello"]
puts [string equal "abc" "abc"]
puts [string equal -nocase "ABC" "abc"]
puts [string replace "hello" 0 1 "j"]
puts [string repeat "ab" 3]
puts [string map {a 1 b 2} "abcab"]
puts [string match "h*" "hello"]
puts [string match "*.tcl" "foo.tcl"]
puts [string is integer "42"]
puts [string is integer "4x"]
