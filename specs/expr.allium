-- allium: 3
-- expr.allium
-- Behaviour spec: Tcl expression evaluation (`expr`, and the expression
-- arguments of if/while/for). Oracle: tclsh 9.1.0 (core-9-1-0).
-- A/B + T1 rules re-anchored 2026-11-27; T2/T7 coverage tracked in
-- HANDOFF-SPEC-910.md §8.
--
-- Scope: numeric type rules, operator semantics, substitutions, errors.
-- Each rule states one observable claim; comments carry the exact probe
-- scripts used for weed checks (see DIVERGENCES.md).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── Numeric typing ────────────────────────────────────────────────

rule ExprIntArithmeticStaysInteger {
    -- + - * on two integer operands produce an integer result.
    when: Evaluates("expr {7 / 2}")
    ensures: completion.code = ok
    ensures: completion.value = "3"
    -- probe: puts [expr {7 / 2}]
}

rule ExprIntDivisionFloors {
    -- Integer division rounds toward negative infinity, not toward zero.
    when: Evaluates("expr {-7 / 2}")
    ensures: completion.code = ok
    ensures: completion.value = "-4"
    -- probe: puts [expr {-7 / 2}]
}

rule ExprIntModuloTakesDivisorSign {
    -- a % b has the sign of b; consistent with floor division.
    when: Evaluates("expr {-7 % 3}")
    ensures: completion.code = ok
    ensures: completion.value = "2"
    -- also: expr {7 % -3} => -2
}

rule ExprMixedFloatResultStaysFloat {
    -- If any operand is a double, arithmetic produces a double, and a
    -- double result stringifies with a decimal point even when integral.
    when: Evaluates("expr {10.0 / 5}")
    ensures: completion.code = ok
    ensures: completion.value = "2.0"
    -- also: expr {2.0 ** 3} => 8.0 ; expr {min(2.0, 3)} => 2.0
}

rule ExprDivisionByZeroErrors {
    -- INTEGER division/modulo by zero is an error. FLOAT division by
    -- zero follows IEEE: 1.0/0.0 => Inf, -1.0/0.0 => -Inf (no error);
    -- NaN-producing forms (0.0/0.0) are a domain error.
    when: Evaluates("expr {1 / 0}")
    ensures: completion.code = error
    ensures: completion.value = "divide by zero"
    -- probe: puts [expr {1.0/0.0}]   =>  Inf     (tclsh 8.6.17/9.1.0, 2026-11-27)
    -- probe: puts [expr {-1.0/0.0}]  =>  -Inf
    -- probe: puts [expr {0.0/0.0}]   =>  domain error: argument not in valid range
}

rule ExprFloatNaNIsDomainError {
    -- Operations with no IEEE-representable value (0.0/0.0) raise a
    -- domain error rather than producing NaN.
    when: Evaluates("expr {0.0 / 0.0}")
    ensures: completion.code = error
    -- oracle: domain error: argument not in valid range
}

rule ExprIntegersAreArbitraryPrecision {
    -- Tcl integers are bignums: 64-bit overflow must not wrap.
    when: Evaluates("expr {9223372036854775807 + 1}")
    ensures: completion.code = ok
    ensures: completion.value = "9223372036854775808"
}

rule ExprLeadingZeroIsDecimal {
    -- 9.1: a leading 0 no longer means octal — 010 is decimal ten.
    -- Octal requires the explicit 0o prefix; 0d and 0b are decimal/binary.
    when: Evaluates("expr {010}")
    ensures: completion.code = ok
    ensures: completion.value = "10"
    -- probe 2026-11-27 tclsh9.1: expr {010} => 10
    -- probe: expr {0o10} => 8 ; expr {0d10} => 10 ; expr {0b101} => 5
    -- also: digit separators are accepted, expr {1_000} => 1000
    -- 8.6 spec pinned "8" (tcl90-changes: 0NNN is no longer octal; TODO T1)
}

-- ── Comparisons ───────────────────────────────────────────────────

rule ExprNumericEqualityIsExact {
    -- == on two numeric operands compares exact numeric values;
    -- there is no epsilon tolerance.
    when: Evaluates("expr {0.1 + 0.2 == 0.3}")
    ensures: completion.code = ok
    ensures: completion.value = "0"
}

rule ExprEqualityNoFloatPrecisionLoss {
    -- Integers beyond 2^53 compare exactly; conversion through double
    -- must not make distinct integers equal.
    when: Evaluates("expr {9007199254740993 == 9007199254740992}")
    ensures: completion.code = ok
    ensures: completion.value = "0"
}

rule ExprEqualityFallsBackToString {
    -- If either operand of == / != is non-numeric, compare as strings.
    when: Evaluates("expr {\"abc\" == \"abc\"}")
    ensures: completion.code = ok
    ensures: completion.value = "1"
}

rule ExprEqNeCompareAsString {
    -- eq / ne ALWAYS compare as strings: a numeric string never equals
    -- its canonicalised form ("1.0" ne "1"), unlike ==.
    when: Evaluates("list [expr {\"1.0\" == 1}] [expr {\"1.0\" eq \"1\"}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0"
    -- also: expr {"abc" < "abd"} => 1 (relational operators compare
    -- numerically when both operands are numeric, else as strings)
}

rule ExprExponentIsRightAssociative {
    -- ** groups right to left.
    when: Evaluates("expr {2 ** 3 ** 2}")
    ensures: completion.code = ok
    ensures: completion.value = "512"
}

-- ── Bitwise and shift operators ───────────────────────────────────

rule ExprBitwiseRequiresIntegers {
    -- | & ^ % and shifts reject floating-point operands.
    when: Evaluates("expr {1 | 2.5}")
    ensures: completion.code = error
    -- oracle 9.1 message (2026-11-27): cannot use floating-point value
    --   "2.5" as right operand of "|" — the message names the value and
    --   the left/right side.
    -- probe: expr {2.5 & 1} => cannot use floating-point value "2.5" as
    --   left operand of "&"
    -- also: expr {10 % 3.0} errors the same way
}

rule ExprNegativeShiftErrors {
    when: Evaluates("expr {1 >> -1}")
    ensures: completion.code = error
    -- oracle message: negative shift argument
}

-- ── Boolean coercion ──────────────────────────────────────────────

rule ExprBooleanCoercion {
    -- Valid booleans: 0/1, true/false, yes/no, on/off (any unique
    -- abbreviation, any case), and any numeric value (0.0 is false,
    -- nonzero is true). Anything else is an error.
    when: Evaluates("expr {0.0 ? 1 : 0}")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- also: expr {!0.0} => 1
    -- error case: if {abc} {...} => error "expected boolean value"
}

rule ExprLogicalShortCircuit {
    -- && and || never evaluate the right operand when the left decides.
    when: Evaluates("expr {0 && [error boom]}")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- also: expr {1 || [error boom]} => 1
}

rule ExprTernaryEvaluatesOnlyTakenBranch {
    when: Evaluates("expr {1 ? 2 : [error boom]}")
    ensures: completion.code = ok
    ensures: completion.value = "2"
}

-- ── Words and substitution inside expressions ─────────────────────

rule ExprBarewordErrors {
    -- A bare word that is not a recognised literal is an error,
    -- never an implicit string.
    when: Evaluates("expr {abc}")
    ensures: completion.code = error
    -- oracle message starts: invalid bareword "abc"
}

rule ExprDoubleQuotedWordsSubstitute {
    -- "..." words inside an expression perform $ and [] substitution;
    -- {...} words do not.
    when: Evaluates("set x world; expr {\" $x\"}")
    ensures: completion.code = ok
    ensures: completion.value = " world"
    -- probe: set x world; puts [expr {" $x"}]
}

rule ExprMalformedListOperandErrors {
    -- in / ni parse the right operand as a list; a malformed list errors.
    when: Evaluates("expr {\"a\" in \"{\"}")
    ensures: completion.code = error
    -- oracle: unmatched open brace in list
}

-- ── 9.1 numeric surface (T1, 2026-11-27) ─────────────────────────
-- Probes: judge/probes/bn2-bn14, expr_lead1/2, bnprobe2, incr_widen,
-- p11/p13/p40, info4. Every value below was re-run on tclsh 9.1.0.

rule ExprRadixPrefixesAreExplicit {
    -- 0o/0x/0b select the radix; a bare leading zero is decimal.
    when: Evaluates("list [expr {0o17}] [expr {0x1A}] [expr {0b101}] [expr {017}]")
    ensures: completion.code = ok
    ensures: completion.value = "15 26 5 17"
    -- probe: bn2/bn4/expr_lead1
}

rule ExprDigitSeparatorsAllowed {
    -- Underscores may separate digits in any radix and are not part of the
    -- value; the underscore must follow a digit (0x_10 is rejected).
    when: Evaluates("list [expr {1_000}] [expr {0o1_7}] [expr {0b1_01}]")
    ensures: completion.code = ok
    ensures: completion.value = "1000 15 5"
    -- probe: bn2/bnprobe2
}

rule ExprLeadingZeroFloatIsDecimal {
    -- Leading-zero floats are decimal too: 08.5 is 8.5, not an octal error.
    when: Evaluates("list [expr {08.5}] [expr {028.1 + 09.2}]")
    ensures: completion.code = ok
    ensures: completion.value = "8.5 37.3"
    -- probe: expr_lead1/expr_lead2
}

rule ExprCommentsRunToEndOfLine {
    -- 9.0 added # comments inside expressions; the rest of the line is
    -- ignored.
    when: Evaluates("expr {1 + 2 # ignored + 3}")
    ensures: completion.code = ok
    ensures: completion.value = "3"
}

rule ExprStringOrderingOpsLtLeGtGe {
    -- lt/le/gt/ge compare as strings, unlike < <= > >= which compare
    -- numerically when both operands are numeric ("2" sorts after "10").
    when: Evaluates("list [expr {2 lt 10}] [expr {2 le 10}] [expr {2 gt 10}] [expr {2 ge 10}] [expr {2 < 10}]")
    ensures: completion.code = ok
    ensures: completion.value = "0 0 1 1 1"
    -- probe: p11/p13
}

rule ExprBooleanListOperandErrors {
    -- A list value in boolean position is a type error, not "true".
    when: Evaluates("expr {\"a b\" ? 1 : 0}")
    ensures: completion.code = error
    ensures: completion.value = "expected boolean value but got a list"
    -- probe: p32/p33 (dict filter/map script bodies)
}

rule ExprNonNumericOperandMessage {
    -- 9.1 names the offending value and the operand side for arithmetic.
    when: Evaluates("catch {expr {\"true\" % 2}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "cannot use non-numeric string \"true\" as left operand of \"%\""
    -- probe: bn10
}

rule ExprNaNValueMessage {
    -- NaN as an arithmetic operand gets the "non-numeric floating-point"
    -- wording (bare `nan` alone is a domain error instead).
    when: Evaluates("catch {expr {nan + 0}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "cannot use non-numeric floating-point value \"nan\" as left operand of \"+\""
    -- probe: bn6/bn7
}

rule ExprNotOperatorMessage {
    -- ! on a non-numeric string names the value and the (unary) operator.
    when: Evaluates("catch {expr {!\"foo\"}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "cannot use non-numeric string \"foo\" as operand of \"!\""
    -- probe: verify
}

rule ExprIncrWidensToBignum {
    -- incr promotes at the i64 boundary in both directions; it never wraps.
    when: Evaluates("set y 9223372036854775807; set z -9223372036854775808; list [incr y] [incr z -1]")
    ensures: completion.code = ok
    ensures: completion.value = "9223372036854775808 -9223372036854775809"
    -- probe: incr_widen/incr_window_p*
}

rule ExprIntConvertsFloatToBignum {
    -- int()/entier() truncate toward zero and widen to arbitrary precision
    -- for large doubles (no 32/64-bit clamp).
    when: Evaluates("list [expr {int(1e22)}] [expr {int(-1.5)}] [expr {entier(-1.5)}]")
    ensures: completion.code = ok
    ensures: completion.value = "10000000000000000000000 -1 -1"
    -- probe: bn2/bn3/bnprobe2
}

rule ExprMathFunctionsC99Core {
    -- The C99 math surface is present (info functions lists 53 names).
    when: Evaluates("list [expr {hypot(3,4)}] [expr {log2(8)}] [expr {exp2(3)}] [expr {copysign(3,-2)}] [expr {fma(2,3,4)}]")
    ensures: completion.code = ok
    ensures: completion.value = "5.0 3.0 8.0 -3.0 10.0"
    -- probe: info4
}

rule ExprMathFunctionsPredicates {
    -- Predicate functions return 0/1 integers, not floating-point booleans.
    when: Evaluates("list [expr {signbit(-1)}] [expr {isunordered(NaN,1)}] [expr {isnormal(1.0)}] [expr {issubnormal(1e-320)}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1 1"
    -- probe: info4
}

rule ExprNewNumericCommands {
    -- 9.1 adds fpclassify/divmod/frexp/modf/remquo; divmod floors like /.
    when: Evaluates("list [fpclassify 0.0] [divmod -7 3] [frexp 8] [modf 3.25] [remquo 7 3]")
    ensures: completion.code = ok
    ensures: completion.value = "zero {-3 2} {0.5 4} {3.0 0.25} {1.0 2}"
    -- probe: info4
}

rule ExprMathopStringComparisons {
    -- ::tcl::mathop gains lt/le/gt/ge alongside the numeric operators.
    when: Evaluates("list [::tcl::mathop::lt 2 10] [::tcl::mathop::le 2 10] [::tcl::mathop::gt 2 10] [::tcl::mathop::ge 2 10]")
    ensures: completion.code = ok
    ensures: completion.value = "0 0 1 1"
    -- probe: p40
}
