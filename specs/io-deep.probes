# io/chan/file/encoding 深水探针（io-deep;probe.sh 差分;末式一律 puts）
puts stdout
puts stderr -nonewline hi; puts ok
set f [open /tmp/rt_io1 w]; puts $f hello; close $f; set f [open /tmp/rt_io1 r]; set n [gets $f v]; set e1 [eof $f]; set n2 [gets $f v]; set e2 [eof $f]; puts [list $n $v $e1 $n2 $e2 [info exists v]]
set f [open /tmp/rt_io2 w]; puts -nonewline $f "héllo"; close $f; set f [open /tmp/rt_io2 r]; puts [string length [read $f 3]]
set f [open /tmp/rt_io3 w]; puts $f abc; close $f; set f [open /tmp/rt_io3 r]; read $f 0; puts [eof $f]
catch {open /tmp/rt_absent_zz r} m; puts $m
set f [open /tmp/rt_io4 w+]; puts $f AAAA; seek $f 0; set c [read $f 2]; puts $f B; close $f; set f [open /tmp/rt_io4 r]; puts [read $f]
set f [open /tmp/rt_io5 w]; puts $f 0123456789; close $f; set f [open /tmp/rt_io5 r]; seek $f 100; puts [list [tell $f] [read $f] [eof $f]]
catch {seek stdin 0} m; puts $m
catch {fconfigure stdout -foo} m; puts $m
catch {fconfigure stdout -encoding bogus} m; puts [fconfigure stdout -encoding]
catch {encoding names} m; puts $m
file mkdir /tmp/rt_gt/a/b; close [open /tmp/rt_gt/a/f2 w]; puts [lsort [glob -nocomplain /tmp/rt_gt/**]]
file mkdir /tmp/rt_gt2; close [open /tmp/rt_gt2/.hid w]; puts [glob -nocomplain -directory /tmp/rt_gt2 *]
close [open /tmp/rt_c1 w]; close [open /tmp/rt_c2 w]; catch {file copy /tmp/rt_c1 /tmp/rt_c2} m; puts $m
close [open /tmp/rt_m w]; file mtime /tmp/rt_m 1000; puts [file mtime /tmp/rt_m]
puts [list [file dirname /] [file tail /] [file rootname x.txt]]
catch {fileevent stdout readable {}} m; puts $m
close [open /tmp/rt_s w]; file stat /tmp/rt_s a; puts [lsort [array names a]]
set f [open /tmp/rt_io6 w]; puts $f x; close $f; set f [open /tmp/rt_io6 r]; gets $f; seek $f 0 current; puts [tell $f]
catch {open /tmp/rt_io7 {RDONLY}} m; puts $m
# ── D-29 编码宽表 + 通道转码（2026-11-06 实测钉形）──
puts [llength [encoding names]]
puts [encoding system]
puts [encoding convertto iso8859-1 "é"]
puts [encoding convertfrom utf-8 [encoding convertto utf-8 "中文"]]
puts [encoding convertto cp1252 "€"]
puts [encoding convertfrom shiftjis [encoding convertto shiftjis "あ"]]
puts [encoding convertto gb2312 [encoding convertfrom gb2312 "中"]]
catch {encoding convertto UTF-8 A} m ; puts $m
catch {encoding convertto bogus A} m o ; puts "$m|[dict get $o -errorcode]"
set f [open /tmp/rt_enc1.txt w] ; fconfigure $f -encoding iso8859-1 ; puts -nonewline $f "é" ; close $f ; set f [open /tmp/rt_enc1.txt r] ; fconfigure $f -encoding iso8859-1 ; set s [read $f] ; close $f ; puts "[string length $s]|[scan $s %c]" ; file delete /tmp/rt_enc1.txt
set f [open /tmp/rt_enc2.txt w] ; fconfigure $f -translation binary ; puts "e=[fconfigure $f -encoding] t=[fconfigure $f -translation]" ; close $f ; file delete /tmp/rt_enc2.txt
set f [open /tmp/rt_enc3.txt w] ; fconfigure $f -encoding binary ; puts -nonewline $f [encoding convertfrom utf-8 "é"] ; close $f ; set f [open /tmp/rt_enc3.txt r] ; fconfigure $f -encoding binary ; set s [read $f] ; close $f ; puts [string length $s] ; file delete /tmp/rt_enc3.txt
set f [open /tmp/rt_enc4.txt w] ; fconfigure $f -encoding shiftjis ; puts $f "あい" ; puts $f "う" ; close $f ; set f [open /tmp/rt_enc4.txt r] ; fconfigure $f -encoding shiftjis ; set a [gets $f] ; set b [gets $f] ; close $f ; puts "$a|$b" ; file delete /tmp/rt_enc4.txt
set f [open /tmp/rt_enc5.txt w] ; fconfigure $f -encoding binary ; puts -nonewline $f [binary format H* ffe9] ; close $f ; set f [open /tmp/rt_enc5.txt r] ; set s [read $f] ; close $f ; puts "[string length $s]|[scan $s %c]" ; file delete /tmp/rt_enc5.txt
encoding system iso8859-1 ; set f [open /tmp/rt_enc6.txt w] ; puts [fconfigure $f -encoding] ; close $f ; encoding system utf-8 ; file delete /tmp/rt_enc6.txt
set f [open /tmp/rt_enc7.txt w] ; fconfigure $f -encoding unicode ; puts -nonewline $f "AB" ; close $f ; set f [open /tmp/rt_enc7.txt r] ; fconfigure $f -encoding binary ; set s [read $f] ; close $f ; puts [string length $s] ; file delete /tmp/rt_enc7.txt
# ── D-30 -translation 输入/输出 EOL（2026-11-06 实测：auto/platform/二元组/gets 行界）──
set f [open /tmp/rt_tr1.txt w] ; puts "q=[fconfigure $f -translation]" ; close $f ; set f [open /tmp/rt_tr1.txt r] ; puts "ro=[fconfigure $f -translation]" ; close $f ; set f [open /tmp/rt_tr1.txt r+] ; puts "rw=[fconfigure $f -translation]|all=[fconfigure $f]" ; close $f ; file delete /tmp/rt_tr1.txt
set f [open /tmp/rt_tr2.txt w] ; fconfigure $f -translation crlf ; puts -nonewline $f "a\\nb" ; close $f ; set f [open /tmp/rt_tr2.txt r] ; fconfigure $f -translation binary ; puts [binary encode hex [read $f]] ; close $f ; file delete /tmp/rt_tr2.txt
set f [open /tmp/rt_tr3.txt w] ; fconfigure $f -translation {auto cr} ; puts -nonewline $f "a\\nb" ; close $f ; set f [open /tmp/rt_tr3.txt r] ; fconfigure $f -translation binary ; puts [binary encode hex [read $f]] ; close $f ; file delete /tmp/rt_tr3.txt
set f [open /tmp/rt_tr4.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set f [open /tmp/rt_tr4.txt r] ; fconfigure $f -translation auto -encoding binary ; puts [binary encode hex [read $f]] ; close $f ; file delete /tmp/rt_tr4.txt
set f [open /tmp/rt_tr5.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set f [open /tmp/rt_tr5.txt r] ; fconfigure $f -translation {cr lf} -encoding binary ; puts [binary encode hex [read $f]] ; close $f ; file delete /tmp/rt_tr5.txt
set f [open /tmp/rt_tr6.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set f [open /tmp/rt_tr6.txt r] ; fconfigure $f -translation auto -encoding binary ; puts [list [gets $f] [gets $f] [gets $f] [gets $f]] ; close $f ; file delete /tmp/rt_tr6.txt
set f [open /tmp/rt_tr7.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set f [open /tmp/rt_tr7.txt r] ; fconfigure $f -translation cr -encoding binary ; puts [list [gets $f] [gets $f] [gets $f]] ; close $f ; file delete /tmp/rt_tr7.txt
set f [open /tmp/rt_tr8.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set f [open /tmp/rt_tr8.txt r] ; fconfigure $f -translation crlf -encoding binary ; puts [list [gets $f] [gets $f]] ; close $f ; file delete /tmp/rt_tr8.txt
set f [open /tmp/rt_tr9.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb" ; close $f ; set f [open /tmp/rt_tr9.txt r] ; fconfigure $f -translation auto -encoding binary ; puts "[binary encode hex [read $f 2]]|[binary encode hex [read $f]]" ; close $f ; file delete /tmp/rt_tr9.txt
set f [open /tmp/rt_tr10.txt w] ; fconfigure $f -encoding unicode -translation crlf ; puts -nonewline $f "a\\nb" ; close $f ; set f [open /tmp/rt_tr10.txt r] ; fconfigure $f -translation binary ; puts [binary encode hex [read $f]] ; close $f ; file delete /tmp/rt_tr10.txt
set f [open /tmp/rt_tr11.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\r\\n" ; close $f ; set f [open /tmp/rt_tr11.txt r] ; fconfigure $f -translation lf -encoding binary ; puts [binary encode hex [read -nonewline $f]] ; close $f ; file delete /tmp/rt_tr11.txt
set f [open /tmp/rt_tr12.txt w] ; catch {fconfigure $f -translation {}} m o ; puts "$m|[dict get $o -errorcode]" ; catch {fconfigure $f -translation bogus} m o ; puts "$m|[dict get $o -errorcode]" ; catch {fconfigure $f -translation {lf lf lf}} m o ; puts "$m|[dict get $o -errorcode]" ; close $f ; file delete /tmp/rt_tr12.txt
set f [open /tmp/rt_tr13.txt w] ; fconfigure $f -translation binary ; puts "t=[fconfigure $f -translation] e=[fconfigure $f -encoding]" ; close $f ; file delete /tmp/rt_tr13.txt
set f [open /tmp/rt_tr14.txt w] ; fconfigure $f -translation {lf lf} ; puts "rw=[fconfigure $f -translation]" ; close $f ; file delete /tmp/rt_tr14.txt
set f [open /tmp/rt_cp1.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f "a\\r\\nb\\rc\\nd" ; close $f ; set s [open /tmp/rt_cp1.txt r] ; fconfigure $s -translation auto -encoding binary ; set d [open /tmp/rt_cp2.txt w] ; fconfigure $d -translation crlf ; set n [chan copy $s $d] ; close $s ; close $d ; set f [open /tmp/rt_cp2.txt r] ; fconfigure $f -translation binary ; puts "$n|[binary encode hex [read $f]]" ; close $f ; file delete /tmp/rt_cp1.txt /tmp/rt_cp2.txt
set f [open /tmp/rt_cp3.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f [binary format H* c3a9c3a9c3a9] ; close $f ; set s [open /tmp/rt_cp3.txt r] ; set d [open /tmp/rt_cp4.txt w] ; fconfigure $d -translation binary -encoding binary ; set n [chan copy $s $d -size 2] ; close $s ; close $d ; set f [open /tmp/rt_cp4.txt r] ; fconfigure $f -translation binary ; puts "$n|[binary encode hex [read $f]]" ; close $f ; file delete /tmp/rt_cp3.txt /tmp/rt_cp4.txt
set f [open /tmp/rt_cp5.txt w] ; fconfigure $f -translation binary ; puts -nonewline $f [binary format H* c3a9c3a9] ; close $f ; set s [open /tmp/rt_cp5.txt r] ; fconfigure $s -encoding binary ; set d [open /tmp/rt_cp6.txt w] ; fconfigure $d -translation binary -encoding iso8859-1 ; set n [chan copy $s $d] ; close $s ; close $d ; set f [open /tmp/rt_cp6.txt r] ; fconfigure $f -translation binary ; puts "$n|[binary encode hex [read $f]]" ; close $f ; file delete /tmp/rt_cp5.txt /tmp/rt_cp6.txt
# ── D-29 .enc 表后端（S/D/M/E；iconv 缺名 + iso2022 系列）──
puts "[binary encode hex [encoding convertfrom macGreek [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto macGreek "Aé中"]]"
puts "[binary encode hex [encoding convertfrom jis0208 [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto jis0208 "Aé中あ"]]"
puts "[binary encode hex [encoding convertfrom big5 [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto big5 "Aé中あ"]]"
puts "[binary encode hex [encoding convertfrom cns11643 [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto cns11643 "Aé中あ"]]"
puts "[binary encode hex [encoding convertfrom ebcdic [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto ebcdic "Aé中"]]"
puts "[binary encode hex [encoding convertfrom iso2022-jp [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto iso2022-jp "Aé中あ"]]"
puts "[binary encode hex [encoding convertfrom iso2022 [binary format H* 41a1c3e9]]]|[binary encode hex [encoding convertto iso2022 "Aé中あ"]]"
puts "[binary encode hex [encoding convertfrom iso2022-kr [binary format H* 41a1c3]]]|[binary encode hex [encoding convertto iso2022-kr "Aé中あ"]]"
