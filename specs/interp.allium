-- allium: 3
-- interp.allium
-- Shared vocabulary for the rtcl behaviour specs.
-- Oracle: tclsh 9.1.0 (core-9-1-0). T4 timer/process/utility rules.
--
-- Scope: observable semantics of evaluating Tcl scripts, as defined by
-- the oracle implementation (tclsh 9.1.0). All sibling specs state
-- claims about what an interpreter must observably do, not how rtcl is built.
-- Excludes: I/O channels, encodings, packages, Tk, performance.

entity Completion {
    -- Every evaluation of a script (or expression) ends in exactly one
    -- completion. This is Tcl's fundamental result contract.
    code: ok | error | return | break | continue | exit
    -- For ok: the result value. For error: the error message.
    -- For return: the payload value. For break/continue: empty.
    -- For exit: the process exit code as text.
    value: String
}

entity Script {
    -- A Tcl script as presented to the interpreter.
    text: String
}

surface Interpreter {
    -- The boundary under specification: a caller hands the interpreter
    -- a script and observes the completion.
    facing _: Script

    provides:
        Evaluates(script)
}

given {
    completion: Completion
}

-- ── 9.1 interpreter-level ensembles (T4, 2026-11-27) ────────────
-- Probes: timer91, process91; re-run on tclsh 9.1.0.

rule TimerInSchedulesAndCancelClears {
    -- timer in returns an after#-shaped id that timer info reports; cancel
    -- removes it silently (empty result).
    when: Evaluates("set id [timer in 10 ms {set done 1}]; list [string match {after#*} $id] [expr {[lsearch -exact [timer info] $id] >= 0}] [timer cancel $id]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 {}"
    -- probe: timer91 (timer at/idle share the after# namespace)
}

rule TimerUnitsResolveByPrefix {
    -- Timer units are a fixed menu resolved by unique prefix; "m" is
    -- ambiguous between ms/microseconds.
    when: Evaluates("list [catch {timer in 1 bla s} m] $m [catch {timer in 1 m s} m2] $m2 [timer sleep for 1 micro]")
    ensures: completion.code = ok
    ensures: completion.value = "1 {bad unit \"bla\": must be us, microseconds, milliseconds, ms, s, or seconds} 1 {ambiguous unit \"m\": must be us, microseconds, milliseconds, ms, s, or seconds} {}"
    -- probe: timer91
}

rule ProcessAutopurgeDefaultsOnAndToggles {
    -- tcl::process autopurge defaults to 1; setting returns the new value.
    -- list/status are empty when no child is tracked.
    when: Evaluates("list [tcl::process autopurge] [tcl::process autopurge false] [tcl::process autopurge] [tcl::process autopurge true] [tcl::process autopurge] [llength [tcl::process list]] [dict size [tcl::process status]]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0 0 1 1 0 0"
    -- probe: process91
}

rule ProcessSubcommandMenu {
    when: Evaluates("catch {tcl::process gorp} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "unknown or ambiguous subcommand \"gorp\": must be autopurge, list, purge, or status"
    -- probe: process91
}

-- ── 9.1 utility/introspection surface (T4, 2026-11-27) ──────────

rule InfoLoadedIsEmptyAtStartup {
    -- info loaded lists packages loaded from shared libraries; the core
    -- is static, so it is empty in a fresh interpreter.
    when: Evaluates("list [info loaded] [info loaded {}]")
    ensures: completion.code = ok
    ensures: completion.value = "{} {}"
    -- probe: 2026-11-27 tclsh9.1
}

rule InfoCmdtypeDistinguishesNative {
    -- info cmdtype reports native for built-ins; an unknown name errors.
    when: Evaluates("list [info cmdtype set] [info cmdtype puts]")
    ensures: completion.code = ok
    ensures: completion.value = "native native"
    -- probe: 2026-11-27 tclsh9.1 (unknown: unknown command "foo")
}

rule BuildInfoReportsCoreVersion {
    -- tcl::build-info starts with the core version.
    when: Evaluates("string match {9.1.0*} [tcl::build-info]")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: 2026-11-27 tclsh9.1 (full string has git hash/compiler)
}

rule PkgconfigKeySetAndFlags {
    -- ::tcl::pkgconfig has 19 keys in 9.1.0; spot flags on this build.
    when: Evaluates("list [llength [::tcl::pkgconfig list]] [::tcl::pkgconfig get debug] [::tcl::pkgconfig get threaded] [::tcl::pkgconfig get 64bit]")
    ensures: completion.code = ok
    ensures: completion.value = "19 0 1 0"
    -- probe: 2026-11-27 tclsh9.1
}

rule UnicodeNormalizationCommand {
    -- unicode is the 9.1 normalization ensemble (tonfc/tonfd/tonfkc/
    -- tonfkd); NFC composes e + U+0301 to é, NFD decomposes it back.
    when: Evaluates("list [unicode tonfc \"e[format %c 0x301]\"] [string length [unicode tonfd \"é\"]]")
    ensures: completion.code = ok
    ensures: completion.value = "é 2"
    -- probe: 2026-11-27 tclsh9.1
}

rule ZipfsRootIsVolumeRoot {
    -- zipfs root returns the mount-point root of the built-in zip volume.
    when: Evaluates("zipfs root")
    ensures: completion.code = ok
    ensures: completion.value = "//zipfs:/"
    -- probe: 2026-11-27 tclsh9.1 (zipfs list is a large file list)
}

rule TimerateReportsRateShape {
    -- timerate returns a human-readable rate line; only the shape is stable.
    when: Evaluates("string match {*µs/#*#/sec*} [timerate {expr 1+1} 1]")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: 2026-11-27 tclsh9.1
}

rule PackageFilesListsScripts {
    -- package files lists the script files of a loaded package (msgcat
    -- ships two here: pkgIndex.tcl and msgcat.tcl).
    when: Evaluates("package require msgcat; list [llength [package files msgcat]] [file tail [lindex [package files msgcat] 0]]")
    ensures: completion.code = ok
    ensures: completion.value = "2 pkgIndex.tcl"
    -- probe: 2026-11-27 tclsh9.1
}

rule TclNamespaceCommandSet {
    -- The ::tcl::* command set has 17 entries in a fresh 9.1.0 (the old
    -- migration note said 27 vs 23); tcl::process is present. Loading
    -- packages may add entries (msgcat adds MacOSXPkgUnknown).
    when: Evaluates("list [llength [info commands ::tcl::*]] [llength [lsearch -exact [info commands ::tcl::*] ::tcl::process]]")
    ensures: completion.code = ok
    ensures: completion.value = "17 1"
    -- probe: 2026-11-27 tclsh9.1 (fresh interpreter)
}

-- ── 9.1 unsupported::assemble (T7, 2026-11-27) ──────────────────
-- Probes: cmp_assemble, unsupported_assemble; 9.1.0 instruction menu.

rule AssembleInstructionSetChanged {
    -- swap is available and land is gone; the menu also adds isEmpty,
    -- strge/strgt/strle/strlt, jumpTableNum, dictGetDef/dictPut/
    -- dictRemove and tclooId. lshift is still present in 9.1.
    when: Evaluates("list [catch {tcl::unsupported::assemble {land}} e] [string match {bad instruction \"land\"*} $e] [catch {tcl::unsupported::assemble {push a; push b; swap; pop}} r] $r")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 0 b"
    -- probe: cmp_assemble/unsupported_assemble
}

rule AssembleReportsStackBalance {
    -- Leaving values on the stack is a compile-time error naming the depth.
    when: Evaluates("catch {tcl::unsupported::assemble {push a; push b}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "stack is unbalanced on exit from the code (depth=2)"
    -- probe: cmp_assemble
}

rule AssembleMenuIncludes9xInstructions {
    -- The 9.1 instruction menu contains isEmpty/strge/jumpTableNum/
    -- dictGetDef/dictPut/dictRemove/tclooId.
    when: Evaluates("catch {tcl::unsupported::assemble {nosuchinstruction}} m; list [string match {*isEmpty*} $m] [string match {*strge*} $m] [string match {*jumpTableNum*} $m] [string match {*dictGetDef*} $m] [string match {*dictPut*} $m] [string match {*dictRemove*} $m] [string match {*tclooId*} $m]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1 1 1 1 1 1"
    -- probe: cmp_assemble/unsupported_assemble
}

rule AssembleStringComparisonsExecute {
    -- strlt and isEmpty execute with normal stack semantics.
    when: Evaluates("list [tcl::unsupported::assemble {push a; push b; strlt}] [tcl::unsupported::assemble {push {}; isEmpty}]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: 2026-11-27 tclsh9.1
}
