-- allium: 3
-- list.allium
-- Behaviour spec: Tcl list values and list commands
-- (list, llength, lindex, lrange, lset, lsort, lsearch, concat/split/join).
-- Oracle: tclsh 9.1.0 (core-9-1-0). T2/T4 rules re-anchored 2026-11-27.

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── List as a string format ───────────────────────────────────────

rule ListCanonicalQuotingRoundTrips {
    -- `list` produces a string from which `lindex` recovers each original
    -- element exactly, for arbitrary element contents (empty, spaces,
    -- unmatched braces, backslashes, quotes).
    when: Evaluates("set x a[format %c 125]b; lindex [list $x] 0")
    ensures: completion.code = ok
    ensures: completion.value = "a}b"
    -- probe: puts [list "a}b"]  =>  a\}b   (backslash form, not "{a}b}")
    -- probe: set l [list "a}b"]; puts [llength [string range $l 0 end]] => 1
}

rule MalformedListIsAnError {
    -- Commands that parse a list reject malformed list strings
    -- (unbalanced braces/quotes); they never silently treat them as
    -- empty or partially parsed lists.
    when: Evaluates("catch {llength [format %c 123]} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "unmatched open brace in list"
    -- oracle message: unmatched open brace in list
    -- applies to: llength, lindex, lrange, lsort, lsearch, lappend,
    --   foreach, lmap, join, string is list, expr in/ni operands
    -- probe: puts [string is list "{"] => 0
    -- probe: set x "{"; lappend x a => error
    -- probe: foreach x "{" {} => error
}

-- ── lindex / lrange ───────────────────────────────────────────────

rule LindexWithoutIndexReturnsWholeList {
    when: Evaluates("lindex {a b}")
    ensures: completion.code = ok
    ensures: completion.value = "a b"
}

rule LindexOutOfRangeIsEmpty {
    when: Evaluates("lindex {a b} 5")
    ensures: completion.code = ok
    ensures: completion.value = ""
    -- end and end-N index forms are supported everywhere an index appears
}

rule LindexMultipleIndicesDescend {
    -- lindex list i j ... descends into nested sublists.
    when: Evaluates("lindex {{a b} {c d}} 1 0")
    ensures: completion.code = ok
    ensures: completion.value = "c"
}

rule LrangeIsInclusive {
    when: Evaluates("lrange {a b c} 1 end")
    ensures: completion.code = ok
    ensures: completion.value = "b c"
    -- first > last, or first past the end, yields the empty list
}

rule LsetOutOfRangeErrors {
    when: Evaluates("set l {a b c}; catch {lset l 5 x} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "index \"5\" out of range"
    -- probe 2026-11-28 tclsh9.1（旧注释误写为 list index out of range）
    -- rtcl: 报 "list index out of range"（越界文案，迁移面）
}

rule LinsertPastEndAppends {
    -- An insert index past the end appends; a negative one clamps to
    -- the front (linsert {a b} 5 X => "a b X", linsert {a b} -1 X => "X a b").
    when: Evaluates("linsert {a b} 5 X")
    ensures: completion.code = ok
    ensures: completion.value = "a b X"
}

rule LreplaceNegativeStartClampsToHead {
    -- lreplace replaces the inclusive index range; a start below zero
    -- clamps to 0 (lreplace {a b} -1 0 X => "X b").
    when: Evaluates("lreplace {a b} -1 0 X")
    ensures: completion.code = ok
    ensures: completion.value = "X b"
    -- a start past the end deletes nothing and appends the new items
    -- (lreplace {a b c} 5 6 X => "a b c X")
}

-- ── lsort / lsearch ───────────────────────────────────────────────

rule LsortDefaultIsAscendingAscii {
    when: Evaluates("lsort {b A a}")
    ensures: completion.code = ok
    ensures: completion.value = "A a b"
}

rule LsortIntegerValidatesElements {
    -- -integer and -real reject elements that do not parse as such.
    when: Evaluates("lsort -integer {a 1}")
    ensures: completion.code = error
    -- oracle message: expected integer but got "a"
    -- also: lsort -real {x 1.5} => error: expected floating-point number...
}

rule LsortUniqueUsesComparisonKey {
    -- -unique removes duplicates according to the active comparison
    -- (so -nocase makes "a" and "A" duplicates); among equal elements
    -- the last one is kept.
    when: Evaluates("lsort -unique -nocase {a A b}")
    ensures: completion.code = ok
    ensures: completion.value = "A b"
}

rule LsortDictionaryComparesNumericRuns {
    when: Evaluates("lsort -dictionary {a10 a2 a1}")
    ensures: completion.code = ok
    ensures: completion.value = "a1 a2 a10"
}

rule LsearchDefaultGlobReturnsIndex {
    when: Evaluates("lsearch {a b c} b")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- -1 when not found; -all returns all matching indices;
    -- -inline returns elements instead of indices
}

-- ── append-style commands ─────────────────────────────────────────

rule LappendCreatesMissingVariable {
    -- lappend to an unset variable creates it.
    when: Evaluates("lappend fresh a b")
    ensures: completion.code = ok
    ensures: completion.value = "a b"
}

rule ConcatJoinsWithSingleSpaces {
    -- concat flattens its arguments, trimming leading/trailing
    -- whitespace of each and joining with single spaces.
    when: Evaluates("concat {a b} {  c  } {}")
    ensures: completion.code = ok
    ensures: completion.value = "a b c"
}

rule SplitProducesEmptyFields {
    when: Evaluates("split \"a,b,,c\" ,")
    ensures: completion.code = ok
    ensures: completion.value = "a b {} c"
}

rule JoinUsesSeparator {
    when: Evaluates("join {a b} -")
    ensures: completion.code = ok
    ensures: completion.value = "a-b"
}

-- ── 9.1 list surface (T4, 2026-11-27) ───────────────────────────
-- Probes: lpop91, lseq91, lfilter91; re-run on tclsh 9.1.0.

rule LpopMutatesListVariable {
    -- lpop removes and returns the element at index; the default index is
    -- the LAST element (lpop l 0 pops the first). A nested index path
    -- descends into sublists.
    when: Evaluates("set l {a b c d}; list [lpop l] $l")
    ensures: completion.code = ok
    ensures: completion.value = "d {a b c}"
    -- probe: lpop91 (lpop l 0 => a; lpop nested 1 2 => f)
}

rule LremoveReturnsFilteredCopy {
    -- lremove returns a copy with the indexed elements removed; the source
    -- string is unchanged.
    when: Evaluates("list [lremove {a b c d e} 2] [lremove {a b c d e} end-1 1] [lremove {a b c d e} 2 end-2]")
    ensures: completion.code = ok
    ensures: completion.value = "{a b d e} {a c e} {a b d e}"
    -- probe: lpop91
}

rule LeditReplacesRangeInPlace {
    -- ledit replaces the first..last range of the named variable with the
    -- given elements and returns the new value.
    when: Evaluates("set l {c d e f g}; list [ledit l 1 2 X Y Z] $l")
    ensures: completion.code = ok
    ensures: completion.value = "{c X Y Z f g} {c X Y Z f g}"
    -- probe: lpop91
}

rule LseqGeneratesNumericSeries {
    -- lseq builds a numeric series; a direction mismatch yields the empty
    -- list, and count/to/by spell the same forms.
    when: Evaluates("list [lseq 3] [lseq 10 .. 1 by -2] [lseq 1 to 9 by 2] [lseq 9 to 1 by 2]")
    ensures: completion.code = ok
    ensures: completion.value = "{0 1 2} {10 8 6 4 2} {1 3 5 7 9} {}"
    -- probe: lseq91 (TIP 746: pure numeric, no expr behaviour)
}

rule LfilterCollectsFirstVariable {
    -- lfilter collects the first loop variable of each varlist when the
    -- body is true; break stops, continue skips.
    when: Evaluates("list [lfilter x {1 2 3 4 5 6} {expr {$x > 2 && $x < 5}}] [lfilter x {1 2 3 4 5} {if {$x == 2} break {expr 1}}]")
    ensures: completion.code = ok
    ensures: completion.value = "{3 4} 1"
    -- probe: lfilter91 (TIP 735)
}

rule LsearchStrideGroupsElements {
    -- -stride scans fixed-size records; -index selects the comparison
    -- column and the returned index is the record start.
    when: Evaluates("list [lsearch -stride 3 -index 1 {a 1 x b 2 y c 3 z} 2] [lsearch -all -stride 2 -index 1 {a 10 b 20 c 30} 20]")
    ensures: completion.code = ok
    ensures: completion.value = "3 2"
    -- probe: 2026-11-27 tclsh9.1; stride 0 => "stride length must be at least 1"
}

rule ListIndicesUseIndexExpressionGrammar {
    -- lindex/lrange/lsort -index share the string-index expression grammar
    -- (one offset term), including the 64-bit range (T2).
    when: Evaluates("list [lindex {a b c d} 1+1] [lrange {a b c d} 1+1 end-1]")
    ensures: completion.code = ok
    ensures: completion.value = "c c"
    -- probe: ix1/ix3 (lsort -index 1+0 works; string repeat counts do not)
}
