# crash-probe: `append`, the other writes made in place (`lappend`, `dict
# set`, `incr`), the order `info globals` / `info vars` list in, and the
# errorCode of a variable that cannot be read or written
#
# `append` rebuilt the whole string on every call — two copies of it; it
# now appends to the variable's own buffer when nothing else holds the
# value.  The other in-place writes took the value out of its table and
# put it back, which left a second entry in the scope's insertion log: a
# listing took the variable for one made anew.  And a variable that was
# unset and made again kept its old place in a listing, where tclsh gives
# it a new one.
#
# Generated by judge/crash-probes/_gen.tcl from _d26_source.tcl; the
# expected values are what tclsh 8.6.17 gave for these very lines (the
# generator's `--refix` pass).  What is left out, and why, is at the top
# of the source.

source [file join [file dirname [info script]] _chk.tcl]
proc T {script} {
    # A success leaves the previous error's errorCode standing: start
    # each check from NONE.
    set ::errorCode NONE
    set c [catch {uplevel 1 $script} r]
    return [list $c $r [expr {[info exists ::errorCode] ? $::errorCode : {}}]]
}
# A skipped check still builds the state the later ones sit on: its
# script runs, unchecked.
proc U {script} {
    catch {uplevel 1 $script}
}
