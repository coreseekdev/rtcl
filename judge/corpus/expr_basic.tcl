# expr arithmetic, precedence, types
puts [expr {1 + 2 * 3}]
puts [expr {(1 + 2) * 3}]
puts [expr {10 / 3}]
puts [expr {10.0 / 3}]
puts [expr {10 % 3}]
puts [expr {-10 % 3}]
puts [expr {2 ** 10}]
puts [expr {1 << 4}]
puts [expr {255 & 15}]
puts [expr {5 > 3}]
puts [expr {"abc" eq "abc"}]
puts [expr {"abc" == "abc"}]
puts [expr {abs(-7)}]
puts [expr {max(3, 9, 4)}]
puts [expr {int(3.99)}]
puts [expr {round(3.5)}]
puts [expr {1 && 0}]
puts [expr {!5}]
puts [expr {1 ? "yes" : "no"}]
set x 42
puts [expr {$x * 2}]
puts [expr {$x > 0 ? $x + 1 : -1}]
