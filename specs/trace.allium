-- allium: 3
-- trace.allium
-- Behaviour spec: the trace command — variable traces (read/write/
-- unset/array), command traces (rename/delete), execution traces
-- (enter/leave/enterstep/leavestep). The legacy `trace variable|vdelete|
-- vinfo` forms were removed in Tcl 9.0 and are pinned here as errors.
-- Oracle: tclsh 9.1.0 (core-9-1-0). A/B rules re-anchored 2026-11-27;
-- remaining C-class coverage tracked in HANDOFF-SPEC-910.md §8.
-- 2026-11-03 distillation round (trace-deep probes live in
-- specs/trace-deep.probes; divergences D-36 … D-39 in DIVERGENCES.md).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── variable traces: registration & info ─────────────────────────

rule TraceOnUncreatedVariableAllowed {
    -- Traces may be registered before the variable exists; they fire
    -- when it comes into being. `unset` (even of a missing variable)
    -- removes the variable's trace records.
    when: Evaluates("llength [trace info variable x]")
    -- after: trace add variable x write cb; unset x
    ensures: completion.code = ok
    ensures: completion.value = "0"
}

rule TraceInfoRoundTripsAndOrdersOps {
    -- trace info variable returns re-listable {{opList callback} ...};
    -- the op list renders in the fixed order array, read, write, unset
    -- regardless of registration order (2026-11-27 re-probed on both
    -- 8.6.17 and 9.1.0; the earlier "read, write, unset, array" note was
    -- wrong for 8.6 as well).
    when: Evaluates("proc cb {args} {}; trace add variable x {write unset} cb; lindex [trace info variable x] 0")
    ensures: completion.code = ok
    ensures: completion.value = "{write unset} cb"
    -- the full command returns a list of such pairs: {{write unset} cb}
    -- full set probe: {{array read write unset} cb}
}

rule TraceRemoveRemovesOneExactMatch {
    -- remove deletes ONE registration per call (exact op-list +
    -- callback-prefix match); duplicate registrations each need their
    -- own remove. No match is a silent no-op.
    when: Evaluates("proc cb {args} {}; trace add variable x write cb; trace add variable x write cb; trace remove variable x write cb; llength [trace info variable x]")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- rtcl: FIXED 2026-11-04（逐条删）
}

rule TraceFiresNewestFirst {
    -- Within one variable, the most recently added trace fires first.
    when: Evaluates("set log {}; proc t1 {args} {lappend ::log T1}; proc t2 {args} {lappend ::log T2}; trace add variable x write t1; trace add variable x write t2; set x 0; set log")
    ensures: completion.code = ok
    ensures: completion.value = "T2 T1"
    -- oracle: T2 T1
}

-- ── variable traces: firing semantics ────────────────────────────

rule WriteTraceRunsAfterCommit {
    -- A write trace runs after the write is committed: on trace error
    -- the value is still set (error can't set "x"), and a callback that
    -- writes the variable changes the final visible value.
    when: Evaluates("proc w {args} {set ::x 9}; trace add variable x write w; set v [set x 0]; list $v $x")
    ensures: completion.code = ok
    ensures: completion.value = "9 9"
    -- probe: puts [list $v [set x]]  =>  9 9   (tclsh)
    -- rtcl: FIXED 2026-11-04（trace_active 重入位 + 写后重读）
}

rule TraceReentrancyDoesNotRefire {
    -- tclsh guards re-entrant access (VAR_TRACE_ACTIVE): a read/write
    -- of the traced variable from inside its own trace callback does
    -- not re-fire the trace.
    when: Evaluates("set n 0; proc r {args} {incr ::n; set y [set ::x]}; trace add variable x read r; set x 1; set x; set n")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- oracle: n = 1 (one fire, inner read silent)
    -- rtcl: FIXED 2026-11-04（同 D-36）
}

rule TraceErrorSemantics {
    -- write-trace error => can't set "x": <e>, write committed;
    -- read-trace error => can't read "x": <e>;
    -- unset-trace errors are swallowed and the unset proceeds.
}

rule UnsetTraceFiresEvenOnFailure {
    -- An unset that names a missing variable still fires unset traces
    -- (and removes the records); for elements, a missing-element unset
    -- fires {a k unset} and drops the element's records.
    when: Evaluates("set log {}; proc cb {args} {lappend ::log $args}; trace add variable nosuch unset cb; catch {unset nosuch}; set log")
    ensures: completion.code = ok
    ensures: completion.value = "{nosuch {} unset}"
    -- rtcl: FIXED 2026-11-05（两条路径都触发；元素还抹记录）
}

rule UnsetWholeArrayFiresElementTraces {
    -- `unset a` fires the unset trace of every element ({a k unset} for
    -- each k) in addition to whole-array traces.
    when: Evaluates("set log {}; proc cb {args} {lappend ::log $args}; set a(1) x; trace add variable a(1) unset cb; unset a; set log")
    ensures: completion.code = ok
    ensures: completion.value = "{a 1 unset}"
    -- rtcl: FIXED 2026-11-05（删除前枚举元素，elem-only 扫描通道）
}

rule ArrayUnsetFiresWholeNotElements {
    -- `array unset a` (no pattern) behaves like `unset a`: ONE whole-
    -- variable {a {} unset} fire, not per-element fires.
    when: Evaluates("set log {}; proc cb {args} {lappend ::log $args}; set a(1) x; trace add variable a unset cb; array unset a; set log")
    ensures: completion.code = ok
    ensures: completion.value = "{a {} unset}"
    -- rtcl: FIXED 2026-11-05（无 pattern 委托 unset_var 全链；D-35 同修）
}

rule ArrayOpFiringSurface {
    -- The array op fires: when array set adds to an ALREADY existing
    -- array; when array get / names / size / exists name a MISSING
    -- array (one fire each); and on array unset.
    when: Evaluates("set log {}; proc cb {args} {lappend ::log A}; set a(1) 1; trace add variable a array cb; array set a {2 2}; set log")
    ensures: completion.code = ok
    ensures: completion.value = "A"
    -- oracle: log = A  (one fire)
    -- rtcl: FIXED 2026-11-05（五子命令分派级恒触发；旧 array.rs 注释
    --   的 trace-5.8 解读被实测矩阵推翻）
}

rule WholeVarThenElementOrder {
    -- When a write fires both whole-variable and element traces, whole-
    -- variable traces run first, element traces second.
    when: Evaluates("set log {}; proc A {args} {append ::log A1}; proc E {args} {append ::log E1}; trace add variable a write A; trace add variable a(k) write E; set a(k) 1; set log")
    ensures: completion.code = ok
    ensures: completion.value = "A1E1"
    -- rtcl: FIXED 2026-11-04（整组先元素组）
}

rule UpvarLinkedAccessFiresTraces {
    -- Reads/writes/unsets through an upvar link fire the target's
    -- traces with the ALIAS name as name1 (upvar 1 g y; set y 5 fires
    -- {y {} write} on g's trace).
    when: Evaluates("set log {}; proc w {args} {lappend ::log [lindex $args 0]}; trace add variable g write w; proc p {} {upvar 1 g y; set y 5}; p; set log")
    ensures: completion.code = ok
    ensures: completion.value = "y"
    -- rtcl: FIXED 2026-11-05（aliased 槽分支 trace 时回落名路径）
}

rule LegacyVariableFormRemoved {
    -- 9.1 keeps only `trace add|info|remove`; the legacy
    -- `trace variable a(k) w cb` spelling is rejected as a bad option.
    when: Evaluates("catch {trace variable a(k) w cb} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "bad option \"variable\": must be add, info, or remove"
    -- probe 2026-11-27 tclsh9.1: catch {trace variable a(k) w cb} m; puts $m
    -- rtcl: 仍暴露 legacy split_elem 路由（迁移面；不为它立 ensures）
}

rule LegacyTraceSubcommandsAllRemoved {
    -- vinfo and vdelete are gone under the same bad-option error; there is
    -- no legacy rwua op validation path left to reach.
    when: Evaluates("list [catch {trace vinfo a(k)} m1] $m1 [catch {trace vdelete a(k) w cb} m2] $m2")
    ensures: completion.code = ok
    ensures: completion.value = "1 {bad option \"vinfo\": must be add, info, or remove} 1 {bad option \"vdelete\": must be add, info, or remove}"
    -- probe 2026-11-27 tclsh9.1
    -- 8.6 spec pinned the legacy "bad operations \"q\": should be one or
    -- more of rwua" message, which no longer exists.
}

-- ── command traces ───────────────────────────────────────────────

rule CommandTracesFireOnRenameAndDelete {
    -- trace add command requires an existing command; the callback sees
    -- {oldName newName op} — {::old ::new rename} on rename (trace
    -- moves with the command) and {::old {} delete} on delete. Redefining
    -- a proc silently drops its traces.
    when: Evaluates("proc cp {} {}; set got {}; proc cb {args} {set ::got $args}; trace add command cp delete cb; rename cp {}; set got")
    ensures: completion.code = ok
    ensures: completion.value = "::cp {} delete"
}

-- ── execution traces ─────────────────────────────────────────────

rule ExecTracesCoverAllCommands {
    -- enter/leave fire for EVERY command invocation (builtins, apply,
    -- namespace eval bodies), not just procs; enterstep/leavestep do
    -- not fire at top level (both sides agree there).
    when: Evaluates("set got {}; proc cb {args} {set ::got $args}; trace add execution set enter cb; set x 1; trace remove execution set enter cb; set got")
    ensures: completion.code = ok
    ensures: completion.value = "{set x 1} enter"
    -- rtcl: FIXED 2026-11-05 for dispatched builtins
    --   (invoke_builtin_traced bracket); bytecode-inlined ops
    --   (set/incr/lappend/expr/while/foreach, slots) remain OPEN [D-39①]
}

rule ExecLeaveArgsAndReturnCompletion {
    -- leave receives {cmdLine code result op} (op last); a body ending
    -- in `return v` still reports code 0 with result v.
    when: Evaluates("set got {}; proc cb {args} {set ::got $args}; proc foo {} {set a 1; return $a}; trace add execution foo leave cb; foo; set got")
    ensures: completion.code = ok
    ensures: completion.value = "foo 0 1 leave"
    -- rtcl: FIXED 2026-11-05（deferred return 解码后进 leave）[D-39]
}

rule ExecTraceFiringOrder {
    -- enter/enterstep fire NEWEST-first; leave/leavestep fire in
    -- registration order (oldest first) — the opposite of variable
    -- traces' uniform latest-first (2026-11-05 file-mode matrix).
    when: Evaluates("set got {}; proc a {args} {lappend ::got A}; proc b {args} {lappend ::got B}; proc foo {} {}; trace add execution foo leave a; trace add execution foo leave b; foo; set got")
    ensures: completion.code = ok
    ensures: completion.value = "A B"
    -- oracle: A's args appear before B's
    -- (enter/enterstep reversed: B before A)
}

rule ExecTraceRecordRemovedMidfireStaysSilent {
    -- A record removed by an earlier callback during the same firing
    -- does not fire (trace-34.1 identity rule, all ops — trace-34.2/34.3).
    when: Evaluates("set got {}; proc foo {} {}; proc soom {args} {lappend ::got SOOM}; proc bar {args} {trace remove execution foo leave soom}; trace add execution foo leave bar; trace add execution foo leave soom; catch {foo}; set got")
    ensures: completion.code = ok
    ensures: completion.value = ""
}

rule ExecTraceHandlerErrorPropagates {
    -- An error inside a leave/enterstep/leavestep handler replaces the
    -- command's result with the error and KEEPS the trace registration.
    when: Evaluates("proc foo {} {}; proc h {args} {error LE}; trace add execution foo leave h; catch {foo} m; list $m [llength [trace info execution foo]]")
    ensures: completion.code = ok
    ensures: completion.value = "LE 1"
    -- rtcl: FIXED 2026-11-05（恒传播 + 记录保留）[D-39]
}

rule ExecEnterstepCoversStackRange {
    -- enterstep/leavestep fire for every traced proc on the call stack
    -- (dynamic range): when traced foo calls bar, foo's enterstep also
    -- reports commands inside bar.
    when: Evaluates("set got {}; proc cb {args} {lappend ::got $args}; proc foo {} {bar}; proc bar {} {set q 1}; trace add execution foo enterstep cb; foo; set got")
    ensures: completion.code = ok
    ensures: completion.value = "{bar enterstep} {{set q 1} enterstep}"
    -- oracle includes: bar enterstep {set q 1} enterstep
    -- rtcl: FIXED 2026-11-05（ExecStepCtx.steps 收全栈）[D-39]
}
