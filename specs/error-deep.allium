-- allium: 3
-- error-deep.allium
-- Behaviour spec: exception semantics deep water — catch options dict,
-- return -code/-level interplay, exit, throw (TIP 388), try trap,
-- errorInfo frames, errorCode lifecycle.
-- Oracle: tclsh 9.1.0 (core-9-1-0). A/B rules re-anchored 2026-11-27;
-- remaining C-class coverage tracked in HANDOFF-SPEC-910.md §8.
-- Known rtcl divergences from this spec are tracked in DIVERGENCES.md
-- (D-3 … D-10；台账为准).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── catch options dict ────────────────────────────────────────────

rule CatchErrorOptionsDictHasSixKeys {
    -- On an error completion the options dict carries exactly six keys:
    -- -code -level -errorcode -errorinfo -errorstack -errorline.  The
    -- KEY ORDER varies by error kind (tclsh's dict construction paths):
    -- error-command raise => code-level-es-ec-ei-el; invalid-command /
    -- invokeStk failures => ec-code-level-es-ei-el; ARITH => 
    -- code-level-ec-ei-el-es (errorstack last).  2026-11-05 pinned.
    when: Evaluates("catch {error boom} m o; dict keys $o")
    ensures: completion.code = ok
    ensures: completion.value = "-code -level -errorstack -errorcode -errorinfo -errorline"
    -- oracle value: -code -level -errorstack -errorcode -errorinfo -errorline
    -- rtcl: FIXED 2026-11-05（六键 + 三序别）[D-2]
    -- probe: catch {error boom} m o; puts [dict keys $o]
}

rule ErrorstackEntries {
    -- -errorstack = flat list [INNER, <body>, CALL, <name>, ...]:
    --   error boom => INNER {returnImm boom {}}
    --   proc p1 {error x}; catch p1 => INNER {returnImm x {}} CALL p1
    --   nosuchcmd a => INNER {invokeStk nosuchcmd a}
    --   two-proc => INNER {invokeStk nosuch z} CALL p1 CALL outer
    -- 9.1 dropped the narrow opcode spellings: invokeStk1 -> invokeStk
    -- (whole family). returnImm is unchanged. 2026-11-27 oracle re-run.
    -- The separate UP <n> token marks unwinding across uplevel (n is the
    -- relative level, as in uplevel; catch.n); it is not part of these
    -- top-level probes.
    -- (2026-11-05 pinned; rtcl FIXED — err_pending_inner one-shot +
    --  call_proc error-exit CALL collection.)
    when: Evaluates("proc p1 {} {error x}; catch {p1} m o; dict get $o -errorstack")
    ensures: completion.code = ok
    ensures: completion.value = "INNER {returnImm x {}} CALL p1"
}

rule CatchNonErrorOptionsLevel {
    -- Top-level `return hi`: catch 2, options -code 0 -level 1. Through a
    -- proc the return converts to ok: catch 0, options -code 0 -level 0.
    -- break/continue are -code 3/4 -level 0.
    when: Evaluates("set r1 [catch {return hi} v o1]; proc f {} {return hi}; set r2 [catch {f} v o2]; list $r1 $o1 $r2 $o2 [catch {break} v o3] $o3 [catch {continue} v o4] $o4")
    ensures: completion.code = ok
    ensures: completion.value = "2 {-code 0 -level 1} 0 {-code 0 -level 0} 3 {-code 3 -level 0} 4 {-code 4 -level 0}"
    -- rtcl: -code 2 -level 0 / -level 1  [D-3 FIXED 2026-11-03]
}

rule CatchReturnCodeErrorViaProcIsError {
    -- `return -code error boom` materialises as an error at the proc
    -- boundary: catch returns 1 and the options dict is -code 1 -level 0.
    when: Evaluates("proc f {} {return -code error boom}; list [catch {f} m o] $m [dict get $o -code] [dict get $o -level]")
    ensures: completion.code = ok
    ensures: completion.value = "1 boom 1 0"
    -- rtcl: -code 2 -level 0 (undecoded)  [D-3 FIXED 2026-11-03]
}

rule CatchReturnCodeIntegerAbove4 {
    -- return -code N for integer N > 4 is caught as code 2 (return);
    -- the raw N lands only in the options dict (-code N -level 1).
    when: Evaluates("catch {return -code 7 x} m o")
    ensures: completion.code = ok
    ensures: completion.value = "2"
    -- oracle $o: -code 7 -level 1
    -- rtcl: catch reports 7 directly  [D-4 FIXED 2026-11-03]
}

rule ReturnLevelTwoValueEscapesTwoFrames {
    -- return -level 2 v (value form) unwinds two frames; caught at the
    -- top it is -code 0 -level 2 in the options dict.
    when: Evaluates("catch {return -level 2 v} m o")
    ensures: completion.code = ok
    ensures: completion.value = "2"
    -- oracle $m: v ; oracle $o: -code 0 -level 2
    -- rtcl: -code 2 -level 0  [D-5]
}

rule ReturnLevelWithCodeErrorMaterialisesAboveNFrames {
    -- return -level N -code error materialises the error N frames above
    -- the thrower: errorInfo shows only frames above the Nth.
    when: Evaluates("proc f1 {} {f2}; proc f2 {} {return -level 2 -code error deep}; catch {f1} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "deep"
    -- oracle errorInfo:
    --   deep
    --       while executing
    --   "f1"
    -- rtcl errorInfo materialises one level early (includes
    --   "f2" + (procedure "f1" line 1) frames)  [D-5]
}

-- ── errorCode lifecycle ───────────────────────────────────────────

rule ReturnErrorcodeDoesNotPolluteGlobalErrorCode {
    -- return -errorcode on a NON-error completion must not write
    -- ::errorCode; the variable stays unset until a real error, so the
    -- next error's code is its own.
    when: Evaluates("proc p {} {return -errorcode {A B} v}; catch p; catch {expr 1/0}; set errorCode")
    ensures: completion.code = ok
    ensures: completion.value = "ARITH DIVZERO {divide by zero}"
    -- rtcl: A B (return -errorcode wrote ::errorCode even on ok)  [D-6 FIXED 2026-11-03]
}

-- ── exit / throw ──────────────────────────────────────────────────

rule ExitIsNotCatchable {
    -- exit terminates the process immediately; catch cannot intercept it
    -- and nothing after it runs.
    when: Evaluates("set ch [file tempfile f]; puts $ch {catch {exit 3} m; puts after}; close $ch; catch {exec [info nameofexecutable] $f} m o; list [lrange [dict get $o -errorcode] 0 0] [lindex [dict get $o -errorcode] end] [string length $m]")
    ensures: completion.code = ok
    ensures: completion.value = "CHILDSTATUS 3 31"
    -- oracle: child prints nothing, process exit code 3, exec reports
    -- "child process exited abnormally" (31 bytes)
    -- rtcl: prints "after", exit code 0 (exit is catchable)  [D-7 FIXED 2026-11-03]
}

rule ThrowIsTip388ErrorCodeMessage {
    -- throw (TIP 388) takes errorCode first, message second:
    -- throw {E C} msg raises msg with errorCode E C.
    when: Evaluates("catch {throw {E C} msg} m; list $m $::errorCode")
    ensures: completion.code = ok
    -- oracle value: msg {E C}
    -- rtcl: jimtcl-style throw code ?msg? — errors with
    --   bad completion code "E C"  [D-8 FIXED 2026-11-03]
}

-- ── try ───────────────────────────────────────────────────────────

rule TryTrapMatchesElementWiseExactPrefix {
    -- try supports trap, but the pattern matching is ELEMENT-WISE EXACT
    -- PREFIX (no glob!): {E} matches [E C]; {E *} does NOT match [E C];
    -- the {ARITH DIVZERO *} idiom does not fire in 8.6 (glob is Tcl 9).
    -- 2026-11-05 oracle reversal: tclsh 8.6.17 dual-probed; 9.1.0 same.
    when: Evaluates("try {error msg2 {} {E C}} trap {E} {m} {set m}")
    ensures: completion.code = ok
    ensures: completion.value = "msg2"
    -- also: trap {E *} on [E C] => the error propagates (no match)
    -- rtcl: FIXED 2026-11-05（原 glob 超集 → 元素级精确前缀）[D-9]
}

rule TryBodyErrorsCarryTryFrame {
    -- An error inside a try body gains a ("try" body line N) frame in
    -- errorInfo.
    when: Evaluates("try {error y} on error {m o} {set ::errorInfo}")
    ensures: completion.code = ok
    -- oracle value contains:
    --   ("try" body line 1)
    -- rtcl: FIXED 2026-11-05（体错误先加帧再落 ::errorInfo）[D-10]
}

rule TryOnHandlerVarListOptional {
    -- The on handler's varList is optional: `on error {} {...}` with an
    -- empty list binds nothing; the 3-word form after the code word is
    -- legal.
    when: Evaluates("catch {try {error x} on error {} {} finally {}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = ""
}
