# 正则/匹配/format/scan/binary/clock 深水探针（probe.sh 差分;反斜杠双写经 printf %b）
puts "[regexp {(a)\\1} a] [regexp {(a+)\\1} aaaa] [regexp {(\\w+)\\s\\1} {hello hello}]"
puts "[regexp {(?:ab|a)(?=c)} abc] [regexp {(?<!x)y} xy] [regexp -inline {(?=a)a} a]"
puts "[regexp {a*?b} aaab] [regexp -inline {(a+?)(a*)} aaa]"
puts "[regexp -inline {\\yfoo\\y} { foo }] [regexp {\\mfoo\\M} afoo] [regexp {\\Aa} a]"
puts [regexp -about {(a)(b)+}]
puts "[regexp {\\u0041} A] [regexp {\\x41} A] [regexp {\\x{41}} A]"
puts "[regexp -lineanchor -start 1 {\\Aa} b\\na] [regexp -start 2 {\\Aa} b\\na]"
puts [regexp -all -inline -indices {a*} bab]
puts "[regexp -inline {b(a|(z)(q))?} b] [regexp -inline {(a)?(b)} b]"
puts "[regsub {(\\w)(\\w)} hi {\\2\\1&}] [regsub {x} x {\\\\&}]"
puts "[string match {[]]} ]] [string match {\\*} *] [string match {} {}] [string match {[a-z]} Q]"
puts "[format %#x 0] [format %#b 5] [format %+d 5] [format %u -1] [format %c 65536] [format %08s ab] [format %-08s ab]"
puts "[format %d 4294967297] [format %hd 65537]"
puts "[scan 12abc {%d%d}] [scan {} %c v] [scan 3.7 {%d} v] [scan 018 %i] [scan -1 %u]"
puts "[scan abc {%[b-z]} v] $v"
puts "[binary scan [binary format n 1] H* h] $h"
puts "[binary scan [binary format t 1 m 1] H* h] $h"
puts "[binary format H3 ABC] [binary format a5 ab] [binary format A5 ab]"
catch {binary format c 4294967296} m; puts $m
puts "[binary scan ab a5 v] [info exists v]"
catch {clock scan 2000-01-01} m2; puts $m2
catch {clock format 86400 -format %z -gmt 1} m3; puts $m3
# ── D-25 clock add / -timezone（2026-11-06 实测钉形；日历夹取/顺序/DST）──
puts [clock add 0 1 day]
puts [clock add 0 1 month]
puts [clock format [clock add [clock scan 2000-01-31 -gmt 1] 1 month] -gmt 1 -format %Y-%m-%d]
puts [clock format [clock add [clock scan 2000-03-31 -gmt 1] -1 month] -gmt 1 -format %Y-%m-%d]
puts [clock format [clock add [clock scan 2000-01-30 -gmt 1] 1 day 1 month] -gmt 1 -format %Y-%m-%d]
puts [clock format [clock add [clock scan 2000-01-30 -gmt 1] 1 month 1 day] -gmt 1 -format %Y-%m-%d]
puts [clock add 0 1 week 1 day]
puts [clock add 0 -1 month]
catch {clock add 0 1 fortnight} m o ; puts "$m|[dict get $o -errorcode]"
catch {clock add 0 1 day -gmt 1 -timezone :UTC} m ; puts $m
catch {clock add 0 1 day -timezone Bogus/Zone} m o ; puts "$m|[dict get $o -errorcode]"
puts [clock format 0 -timezone :America/New_York -format {%Y-%m-%d %H:%M %Z %z}]
puts [clock add [clock scan 2024-03-09 -gmt 1] 3 days]
puts [clock scan {2021-03-13 12:00:00} -format {%Y-%m-%d %H:%M:%S} -gmt 1]
puts [clock format [clock add [clock scan {2021-03-13 12:00:00} -format {%Y-%m-%d %H:%M:%S}] 1 day -timezone :America/New_York] -timezone :America/New_York -format {%Y-%m-%d %H:%M:%S %Z %z}]
# ── D-25 clock scan -format（strptime 面；2026-11-06 实测钉形）──
puts [clock scan "31/12/1999" -format %d/%m/%Y -gmt 1]
puts [clock scan "1999-12-31 23:59:58" -format "%Y-%m-%d %H:%M:%S" -gmt 1]
puts [clock scan "12:30" -format %H:%M -base 0 -gmt 1]
puts [clock scan "Dec 31 1999" -format "%b %d %Y" -gmt 1]
puts [clock scan "99-12-31" -format "%y-%m-%d" -gmt 1]
puts [clock scan "2000-02-30" -format %Y-%m-%d -gmt 1]
puts [clock scan "2000-060" -format "%Y-%j" -gmt 1]
puts [clock scan "11:30 PM" -format "%I:%M %p" -base 0 -gmt 1]
puts [clock scan "0001-01-01" -format %Y-%m-%d -gmt 1]
puts [clock scan "1582-10-04" -format %Y-%m-%d -gmt 1]
puts [clock scan "1752-09-14" -format %Y-%m-%d -gmt 1]
puts [clock scan " 2000-01-05 " -format "%Y-%m-%d" -gmt 1]
catch {clock scan "2000-01-01" -format "%Y-%m-%d %H:%M"} m o ; puts "$m|[dict get $o -errorcode]"
puts [clock scan "2000-01-05 +0100" -format "%Y-%m-%d %z" -gmt 1]
puts [clock format [clock scan "2000-01-01" -format %Y-%m-%d -gmt 1] -gmt 1 -format %Y-%m-%d]
