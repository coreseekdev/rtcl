proc sh {s} { puts $s }
set r [scan {0xzz} {%x%n} v n]; sh "x0xzz: r=$r v=$v n=$n"
set r [scan {0x} {%x%n} v n]; sh "x0x: r=$r v=$v n=$n"
set r [scan {0b1} {%i%n} v n]; sh "i0b1: r=$r v=$v n=$n"
set r [scan {0o7} {%i%n} v n]; sh "i0o7: r=$r v=$v n=$n"
set r [scan {0xg} {%i%n} v n]; sh "i0xg: r=$r v=$v n=$n"
set r [scan {inf} {%f%n} v n]; sh "finf: r=$r v=$v n=$n"
set r [scan {infX} {%f%n} v n]; sh "finfX: r=$r v=$v n=$n"
set r [scan {infin} {%f%n} v n]; sh "finfin: r=$r v=$v n=$n"
set r [scan {infini} {%f%n} v n]; sh "infini: r=$r v=$v n=$n"
set r [scan {infinite} {%f%n} v n]; sh "infinite: r=$r v=$v n=$n"
set r [scan {NaN} {%f%n} v n]; sh "fNaN: r=$r v=[info exists v] n=[info exists n]"
set r [scan {12NaN} {%f%n} v n]; sh "f12NaN: r=$r v=$v n=$n"
set r [scan {+} {%d} w]; sh "d+only: r=$r"
set r [scan {+} {%1d} w]; sh "d+1: r=$r"
set r [scan {1} {%1f} w]; sh "f1: r=$r w=[info exists w]"
set r [scan {12} {%2f} w]; sh "f2w: r=$r"
set r [scan {na} {%2f} w]; sh "fna2: r=$r"
set r [scan {n} {%2f} w]; sh "fn2: r=$r"
set r [scan {12e} {%d} w]; sh "d12e: r=$r w=[info exists w]"
set r [scan {1.5} {%d} w]; sh "d1.5: r=$r w=$w"
set r [scan {-99999999999999999999} %d w]; sh "dmin: r=$r w=$w"
set r [scan {-0x10} %x w]; sh "x-neg: r=$r w=$w"
set r [scan {77777777777777777777777} %o w]; sh "o-ovf: r=$r w=$w"
set r [scan {111111111111111111111111111111111111111111111111111111111111111111} %b w]; sh "b-ovf: r=$r w=$w"
