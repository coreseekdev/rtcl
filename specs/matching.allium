-- allium: 3
-- matching.allium
-- Behaviour spec: pattern matching and value formatting — regexp /
-- regsub (Tcl ARE), string match (glob), format / scan, binary, clock.
-- Oracle: tclsh 9.1.0 (core-9-1-0). T1 (format/scan) and T7 regex wording
-- re-anchored 2026-11-27; assemble/binary coverage tracked in
-- HANDOFF-SPEC-910.md §8.
-- rtcl divergences from this spec are tracked in DIVERGENCES.md
-- (D-18 … D-27；台账为准).

use "./interp.allium" as interp

given {
    completion: interp/Completion
}

-- ── regexp: Tcl ARE surface ───────────────────────────────────────

rule RegexpSupportsBackreferences {
    -- Backreferences \1..\9 are ARE syntax and must work.
    when: Evaluates("list [regexp {(a+)\\1} aaaa] [regexp {(a)\\1} a]")
    ensures: completion.code = ok
    ensures: completion.value = "1 0"
}

rule RegexpSupportsLookahead {
    -- Lookahead constraints (?=re) / (?!re) are ARE syntax and work.
    when: Evaluates("list [regexp {(?=c)ab|a} abc] [regexp {(?!x)a} abc]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
}

rule RegexpLookbehindIsCompileError {
    -- Lookbehind constraints (?<=re) / (?<!re) do not exist in tclsh
    -- 8.6 ARE; both fail to compile.
    when: Evaluates("regexp {(?<!x)y} xy")
    ensures: completion.code = error
    -- oracle: cannot compile regular expression pattern: invalid quantifier operand
    -- rtcl: fast-engine routing misses (?<= / (?<! and leaks the Rust
    --   regex-crate parse error; the BT fallback would answer 0/1
    --   (a superset of tclsh)  [D-17]
}

rule RegexpAcceptsNonCapturingGroups {
    -- Tcl ARE does support (?:...) non-capturing groups (it is (?<...) /
    -- lookbehind that is absent).
    when: Evaluates("regexp {(?:ab|a)(?=c)} abc")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- probe: 2026-11-27 tclsh9.1 (8.6.17 also accepts; the old
    --   RegexpRejectsNonCapturingGroups rule was wrong)
}

rule RegexpUnicodeEscapeIsAccepted {
    -- \uXXXX is a valid ARE escape (matches U+0041); the brace form
    -- \x{...} is not. \x41 two-digit hex is valid.
    when: Evaluates("list [regexp {\\u0041} A] [catch {regexp {\\x{41}} A} m]")
    ensures: completion.code = ok
    ensures: completion.value = "1 1"
    -- probe: 2026-11-27 tclsh9.1 (8.6.17 behaves the same); the brace
    --   form errors REGEXP REG_EESCAPE "invalid escape \ sequence".
}

rule RegexpLazyQuantifierPreference {
    -- Tcl's engine preference for (a+?)(a*) on "aaa": the lazy group
    -- takes its minimum and the match stops there — the full match is
    -- "a", not "aaa".
    when: Evaluates("regexp -inline {(a+?)(a*)} aaa")
    ensures: completion.code = ok
    ensures: completion.value = "a a {}"
    -- rtcl: "aaa a aa" (backtracking-first semantics)  [D-19]
}

rule RegexpLineanchorDoesNotMoveA {
    -- \A binds to the -start offset only; -lineanchor must not turn \A
    -- into a line-start assertion.
    when: Evaluates("regexp -lineanchor -start 1 {\\Aa} \"b\\na\"")
    ensures: completion.code = ok
    ensures: completion.value = "0"
    -- rtcl: 1 (rewrites \A to (?m)^ inside the fast engine)  [D-20]
    -- probe without -lineanchor: regexp -start 2 {\Aa} "b\na" => 1 (both)
}

-- ── regsub ────────────────────────────────────────────────────────

rule RegsubBackrefsAndEscapes {
    -- \1..\9 are group refs, & is the whole match, \\ is a literal
    -- backslash in the replacement.
    when: Evaluates("list [regsub {(\\w)(\\w)} hi {\\2\\1&}] [regsub {x} x {\\\\&}]")
    ensures: completion.code = ok
    ensures: completion.value = "ihhi {\\x}"
    -- probe: 2026-11-27 tclsh9.1 (list quotes the backslash element)
}

rule RegsubRejectsUnknownOption {
    -- 9.1 regsub option menu includes -command; anything else is a bad
    -- option.
    when: Evaluates("catch {regsub -bogus {o} foo up x} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "bad option \"-bogus\": must be -all, -command, -expanded, -line, -linestop, -lineanchor, -nocase, -start, or --"
    -- probe: 2026-11-27 tclsh9.1
}

-- ── string match ──────────────────────────────────────────────────

rule StringMatchRejectsExtraArgsAsOptions {
    -- With more than 3 words tclsh parses the first extra word as an
    -- option and reports it.
    when: Evaluates("string match a b c")
    ensures: completion.code = error
    -- oracle: bad option "a": must be -nocase
    -- rtcl: returns 0 (silently treats words as pattern/string)  [D-22]
}

rule StringMatchNocaseIsPerCharSimpleFold {
    -- -nocase folds per character (simple case mapping): İ (U+0130)
    -- matches i.
    when: Evaluates("string match -nocase İ i")
    ensures: completion.code = ok
    ensures: completion.value = "1"
    -- rtcl: 0 (whole-string Rust to_lowercase gives two-char expansion)  [D-22]
}

-- ── format / scan ─────────────────────────────────────────────────

rule FormatCRendersUnicodeScalar {
    -- 9.1 raised %c's ceiling from the 16-bit Tcl_UniChar to the Unicode
    -- scalar range 0..0x10FFFF. Out-of-range and negative values render
    -- U+FFFD (65533).
    when: Evaluates("list [scan [format %c 65536] %c] [scan [format %c 128512] %c] [scan [format %c 1114112] %c]")
    ensures: completion.code = ok
    ensures: completion.value = "65536 128512 65533"
    -- probe: format_grammarD (1114112 => U+FFFD); 8.6 capped every value
    --   above 65535 at U+FFFD, which is why this rule was BMP-only.
}

-- ── 9.1 format/scan widths and grammar (T1, 2026-11-27) ─────────

rule FormatIntegerTruncatesTo32Bits {
    -- Without a size modifier, integer conversions use the C target width
    -- (32-bit for d/i/u/o/x/b, 16-bit for h) and truncate modulo that
    -- width rather than saturating. l/ll/L and j/q/z/t select 64 bits.
    when: Evaluates("list [format %d 2147483648] [format %u -1] [format %x -255] [format %ld 3000000000] [format %lld 30000000000] [format %hd 65535]")
    ensures: completion.code = ok
    ensures: completion.value = "-2147483648 4294967295 ffffff01 3000000000 30000000000 -1"
    -- probe: format_grammarE/format_grammarD/p45
}

rule FormatAlternatePrefixes {
    -- %# prefixes: octal uses the 9.x 0o form, binary 0b, hex 0x; a zero
    -- value gets no prefix (C99 rule).
    when: Evaluates("list [format %#o 5] [format %#o 0] [format %#x 0] [format %#b 5]")
    ensures: completion.code = ok
    ensures: completion.value = "0o5 0 0 0b101"
    -- probe: format_grammarC
}

rule FormatSizeModifiersSelect64Bit {
    -- j/q/z/t (and L/ll) select a 64-bit target even without a wider
    -- integer; bare conversions are the only 32-bit path.
    when: Evaluates("list [format %jd 30000000000] [format %qd 30000000000] [format %zd 30000000000] [format %td 30000000000] [format %Ld 30000000000]")
    ensures: completion.code = ok
    ensures: completion.value = "30000000000 30000000000 30000000000 30000000000 30000000000"
    -- probe: p45/format_grammarD (9.0.1 completed the modifier set)
}

rule ScanSizeModifiersSelect64Bit {
    -- The same modifiers work on scan's integer conversions.
    when: Evaluates("list [scan 30000000000 %jd] [scan 30000000000 %qd] [scan 30000000000 %zd] [scan 30000000000 %td] [scan 30000000000 %Ld]")
    ensures: completion.code = ok
    ensures: completion.value = "30000000000 30000000000 30000000000 30000000000 30000000000"
    -- probe: p45/p48
}

rule FormatIntegerLiteralGrammar {
    -- Integer arguments are parsed with the 9.1 literal grammar: 0b/0o,
    -- leading-zero decimal and underscore separators all work.
    when: Evaluates("list [format %d 1_000] [format %d 0b101] [format %d 017] [format %d 08]")
    ensures: completion.code = ok
    ensures: completion.value = "1000 5 17 8"
    -- format %d 0o18 => expected integer but got "0o18"
    -- probe: format_grammarF
}

rule FormatIncompleteSpecifierErrors {
    -- A specifier cut off before its conversion letter is INCOMPLETE.
    when: Evaluates("catch {format {%.} 5} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "format string ended in middle of field specifier"
    -- errorCode: TCL FORMAT INCOMPLETE ; probe: format_grammarG (%. / %q)
}

rule FormatSpecifierMixErrors {
    -- Positional (%n$) and sequential (%) conversions cannot be mixed.
    when: Evaluates("catch {format {%d %1$d} 1 2} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "cannot mix \"%\" and \"%n$\" conversion specifiers"
    -- errorCode: TCL FORMAT MIXEDSPECTYPES ; probe: format_grammarC/G
}

rule FormatNotEnoughArguments {
    -- A trailing % with no argument is a field/variable mismatch.
    when: Evaluates("catch {format {ab%}} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "not enough arguments for all format specifiers"
    -- errorCode: TCL FORMAT FIELDVARMISMATCH ; probe: format_grammar8/G
}

rule ScanIntegerTruncatesTo32Bits {
    -- scan mirrors format: %d/%i/%x are 32-bit and truncate modulo 2^32;
    -- an overflowing digit run saturates at INT_MAX.
    when: Evaluates("list [scan 3000000000 %d] [scan 2147483648 %d] [scan 99999999999999999999 %d] [scan 3000000000 %ld] [scan ffffffffffffffff %x]")
    ensures: completion.code = ok
    ensures: completion.value = "-1294967296 -2147483648 2147483647 3000000000 -1"
    -- probe: p45/p51/scan_overflow
}

rule ScanIntegerLiteralGrammar {
    -- scan's %i honours C-style octal (010 => 8) and %o/%x/%b their
    -- bases, unlike expr where a leading zero is decimal.
    when: Evaluates("list [scan 010 %i] [scan 017 %o] [scan 0x10 %x] [scan 0b101 %b]")
    ensures: completion.code = ok
    ensures: completion.value = "8 15 16 5"
    -- probe: p44/p48
}

rule ScanOverflowSaturates {
    -- A 17-digit hex run saturates at INT_MAX / INT_MIN (32-bit target).
    when: Evaluates("list [scan fffffffffffffffff %x] [scan -ffffffffffffffff %x]")
    ensures: completion.code = ok
    ensures: completion.value = "2147483647 -2147483648"
    -- probe: p51/scan_overflow
}

rule ScanCharReturnsCodePoint {
    -- %c scans one character and returns its code point; width/size
    -- modifiers are rejected (there is exactly one character).
    when: Evaluates("list [scan é %c] [catch {scan -12 {%2c%n} a b} m] $m")
    ensures: completion.code = ok
    ensures: completion.value = "233 1 {field width may not be specified in %c conversion}"
    -- probe: p45/p48 (size modifier gets the analogous message)
}

rule ScanFloatSpecialValues {
    -- inf/-inf spellings are accepted and yield Inf/-Inf; a NaN token
    -- consumes nothing (zero conversions, p51).
    when: Evaluates("list [scan Inf %f] [scan -Infinity %f] [scan 1e3 %f]")
    ensures: completion.code = ok
    ensures: completion.value = "Inf -Inf 1000.0"
    -- probe: p48/p51 (scan NaN %f reports zero conversions)
}

-- ── binary ────────────────────────────────────────────────────────

rule BinaryNetworkFieldsAreBigEndian {
    -- t/n/m (16/32/64-bit network order) are big-endian on both format
    -- and scan. (Verified: binary scan [binary format n 1] H* => 00000001.)
    when: Evaluates("binary scan [binary format t 1 m 1] H* h")
    ensures: completion.code = ok
    -- oracle h: 00010000000000000000000000000000 ... (t big-endian, then m)
    -- rtcl matches tclsh here (earlier suspicion of LE bug was wrong)
}

rule BinaryScanShortInputLeavesVarsUnset {
    when: Evaluates("set r [binary scan ab a5 v]; list $r [info exists v]")
    ensures: completion.code = ok
    ensures: completion.value = "0 0"
}

-- ── 9.1 binary float bit fidelity (T7, 2026-11-27) ──────────────
-- Probe: pbr6_float_bits. 9.1.0 emits canonical IEEE-754 bits; the old
-- rtcl saturation to 7f7fffff / 7fefffffffffffff is a code divergence.

rule BinaryFormatFloatNonFiniteBits {
    -- Single precision canonical bits: Inf/-Inf/NaN/-0.0.
    when: Evaluates("list [binary encode hex [binary format R Inf]] [binary encode hex [binary format R -Inf]] [binary encode hex [binary format R NaN]] [binary encode hex [binary format R -0.0]]")
    ensures: completion.code = ok
    ensures: completion.value = "7f800000 ff800000 7fc00000 80000000"
    -- probe: pbr6_float_bits
}

rule BinaryFormatDoubleNonFiniteBits {
    -- Double precision canonical bits: Inf/-Inf/NaN/-0.0.
    when: Evaluates("list [binary encode hex [binary format Q Inf]] [binary encode hex [binary format Q -Inf]] [binary encode hex [binary format Q NaN]] [binary encode hex [binary format Q -0.0]]")
    ensures: completion.code = ok
    ensures: completion.value = "7ff0000000000000 fff0000000000000 7ff8000000000000 8000000000000000"
    -- probe: pbr6_float_bits
}

rule BinaryFormatLittleEndianFloatBits {
    -- The r/q forms are the byte-reversed R/Q forms.
    when: Evaluates("list [binary encode hex [binary format r Inf]] [binary encode hex [binary format r NaN]] [binary encode hex [binary format q Inf]] [binary encode hex [binary format q NaN]]")
    ensures: completion.code = ok
    ensures: completion.value = "0000807f 0000c07f 000000000000f07f 000000000000f87f"
    -- probe: pbr6_float_bits
}

rule BinaryScanRoundTripsNonFinite {
    -- Scanning the canonical bytes recovers Inf/-Inf.
    when: Evaluates("list [binary scan [binary format R Inf] R x] $x [binary scan [binary format Q -Inf] Q y] $y")
    ensures: completion.code = ok
    ensures: completion.value = "1 Inf 1 -Inf"
    -- probe: pbr6_float_bits
}

-- ── clock ─────────────────────────────────────────────────────────

rule ClockFormatUsesLocalTimezone {
    -- clock format renders in the process's local timezone (%Z/%z give
    -- its abbreviation/offset); TZ is honoured.
    when: Evaluates("clock format 0")
    ensures: completion.code = ok
    -- oracle (TZ=Asia/Shanghai): Thu Jan 01 08:00:00 CST 1970
    -- rtcl: always UTC "Thu Jan 01 00:00:00 UTC 1970"  [D-24]
    -- probe: clock format 0 -format "%Z %z"  =>  CST +0800
    -- rtcl: "UTC %z" — %z conversion is also missing  [D-24]
}

rule ClockScanSupportsIsoDates {
    -- clock scan parses ISO and free-form dates.
    when: Evaluates("clock scan 2000-01-01")
    ensures: completion.code = ok
    -- oracle: 946656000
    -- rtcl: "clock scan: format parsing not yet implemented"  [D-24]
}

rule ClockAddWeekdaysSkipsWeekend {
    -- clock add ... weekdays counts business days (Sat/Sun skipped):
    -- Wed 2020-01-01 + 5 weekdays = Wed 2020-01-08.
    when: Evaluates("set t [clock scan 2020-01-01 -gmt 1]; clock format [clock add $t 5 weekdays -gmt 1] -format %Y-%m-%d -gmt 1")
    ensures: completion.code = ok
    ensures: completion.value = "2020-01-08"
    -- probe: 2026-11-27 tclsh9.1
}

rule ClockScanValidateControlsRangeAdjustment {
    -- -validate 1 (default) raises on an out-of-range day; -validate 0
    -- normalises it (2020-02-31 -> 2020-03-02). Syntax errors still raise.
    when: Evaluates("list [catch {clock scan 2020-02-31 -validate 1 -gmt 1} m] $m [clock format [clock scan 2020-02-31 -validate 0 -gmt 1] -format %Y-%m-%d -gmt 1]")
    ensures: completion.code = ok
    ensures: completion.value = "1 {unable to convert input string: invalid day} 2020-03-02"
    -- probe: 2026-11-27 tclsh9.1
}

-- ── glob ──────────────────────────────────────────────────────────

rule GlobMatchesTclGlobSemantics {
    -- glob uses Tcl's glob rules: ** is two *s (no recursion), {a,b}
    -- is NOT alternation, leading dots are not matched by *.
    when: Evaluates("glob -nocomplain {a,b}")
    ensures: completion.code = ok
    -- oracle: {} (literal braces as filename chars)
    -- rtcl: uses the Rust glob crate: ** recursion + {} alternation +
    --   leading-dot matching diverge  [D-25]
    -- probe: glob -nocomplain **/*.md  — rtcl recurses; tclsh does not
}

rule RegexpCompileErrorWording {
    -- 9.1 says "cannot" (not "couldn't") and "invalid quantifier operand"
    -- (not the 8.6 "quantifier operand invalid"); the errorCode detail follows.
    when: Evaluates("catch {regexp {a**} x} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "cannot compile regular expression pattern: invalid quantifier operand"
    -- probe: p6/v_re (regsub uses the same wording)
}

-- ── 9.1 regsub -command (T4, 2026-11-27) ────────────────────────

rule RegsubCommandEvaluatesPrefix {
    -- -command evaluates the prefix with (whole match, captures...) per
    -- match; its result replaces the match and & / \n lose template
    -- meaning.
    when: Evaluates("list [regsub -command {.x.} {abcxdef} {string length}] [regsub -all -command {(b)|(z)} {abcxdef} {list}]")
    ensures: completion.code = ok
    ensures: completion.value = "ab3ef {ab b {}cxdef}"
    -- probe: regsubcmd91 (TIP 463)
}

rule RegsubCommandEmptyPrefixErrors {
    -- An empty command prefix is its own error.
    when: Evaluates("catch {regsub -command {b} {abcxdef} {} v} m; set m")
    ensures: completion.code = ok
    ensures: completion.value = "command prefix must be a list of at least one element"
    -- errorCode: TCL OPERATION REGSUB CMDEMPTY ; probe: regsubcmd91
}
