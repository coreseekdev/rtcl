# crash-probe: d22 `string map`
# `string map` rebuilt what was left of the string at every character:
# quadratic, and for each pair of the map — 64KB with two pairs took a
# second (tclsh 0.8ms), 400KB did not finish in a hundred seconds.  An
# odd map gave no errorCode and a map that was not a list was quietly
# taken for one word.
#
# Expected values are tclsh 8.6.17's own outputs, check by check, in the
# order the state is built: _gen.tcl writes this file from
# _d22_source.tcl.

source [file join [file dirname [info script]] _chk.tcl]
proc T {script} {
    # A success leaves the previous error's errorCode standing: start
    # each check from NONE.
    set ::errorCode NONE
    set c [catch {uplevel 1 $script} r]
    return [list $c $r [expr {[info exists ::errorCode] ? $::errorCode : {}}]]
}
# A skipped check still builds the state the later ones sit on: its
# script runs, unchecked.
proc U {script} {
    catch {uplevel 1 $script}
}
set ::errorCode NONE
chk first-listed [T {string map {a b ab cd} ab}] {0 bb NONE}
chk first-listed2 [T {string map {ab cd a b} ab}] {0 cd NONE}
chk equal-length-order [T {string map {ab X ab Y} ab}] {0 X NONE}
chk empty-source [T {string map {{} x a b} a}] {0 b NONE}
chk empty-input [T {string map {a b} {}}] {0 {} NONE}
chk empty-map [T {string map {{}} abc}] {1 {char map list unbalanced} {TCL OPERATION MAP UNBALANCED}}
chk nocase [T {string map -nocase {AB x} aabAB}] {0 axx NONE}
chk nocase-order [T {string map -nocase {a X aa Y} AAa}] {0 XXX NONE}
chk nocase-turkish [T {string map -nocase {i x} İI}] {0 xx NONE}
chk nocase-ligature [T {string map -nocase {ß x} ẞ}] {0 x NONE}
chk nocase-multi [T {string map -nocase {abc X} aBcABCabcd}] {0 XXXd NONE}
chk nocase-dst-case [T {string map -nocase {abc Xy} ABC abc}] {1 {wrong # args: should be "string map ?-nocase? charMap string"} {TCL WRONGARGS}}
chk unicode [T {string map {é e} déjà éÉ}] {1 {bad option "é e": must be -nocase} {TCL LOOKUP INDEX option {é e}}}
chk unicode-3 [T {string map {日 本} 日本日}] {0 本本本 NONE}
chk unicode-4 [T {string map {😀 x} a😀b😀}] {0 axbx NONE}
chk unicode-nocase [T {string map -nocase {É x} éÉ}] {0 xx NONE}
chk bad-option [T {string map -x {a b} aaa}] {1 {bad option "-x": must be -nocase} {TCL LOOKUP INDEX option -x}}
chk two-args [T {string map -nocase {a b}}] {1 {char map list unbalanced} {TCL OPERATION MAP UNBALANCED}}
chk odd-map [T {string map {a} x}] {1 {char map list unbalanced} {TCL OPERATION MAP UNBALANCED}}
chk odd-map2 [T {string map {a b c} x}] {1 {char map list unbalanced} {TCL OPERATION MAP UNBALANCED}}
chk odd-map3 [T {string map {} x}] {0 x NONE}
chk not-a-list [T {string map {a \{b} x}] {0 x NONE}
chk empty-everything [T {string map {} {}}] {0 {} NONE}
chk long-source [T {string map {aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa X} aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}] {0 XXaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa NONE}
chk many-pairs [T {string map {a 1 b 2 c 3 d 4 e 5 f 6 g 7 h 8} abcdefgh}] {0 12345678 NONE}
chk overlapping [T {string map {abc X ab Y} aabcab}] {0 aXY NONE}
chk chain [T {string map {a b b c} abab}] {0 bcbc NONE}
chk big-input [T {string map {a b b c} }] {0  NONE}

# 28 lines; the chk ones are the checks.
